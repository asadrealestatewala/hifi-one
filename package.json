{
  "name": "hifi-one",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "node scripts/db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "roles:sync": "tsx scripts/sync-roles.mts",
    "backup:check": "node scripts/check-backup.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "docs:roles": "tsx scripts/gen-role-matrix.mts",
    "db:backup": "node scripts/backup-local.mjs backup",
    "db:restore": "node scripts/backup-local.mjs restore"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "embedded-postgres": "^17.10.0-beta.17",
    "jose": "^6.2.12",
    "next": "15.5.27",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "deepmerge-ts": "^8.0.2"
  }
}
