# Copy to .env.production on the server and fill every value. Never commit the real file.
DB_PASSWORD=
SESSION_SECRET=            # 48+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_URL=https://erp.example.com
# SETUP_TOKEN=             # optional; /setup checks it only if entered. Without it, finish /setup right after the first deploy
# Optional
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# Resend API (preferred over SMTP when set; also needed to receive mail). Full-access key.
# RESEND_API_KEY=""
# Signing secret of the Resend webhook for the email.received event (whsec_...). Receiving stays off without it.
# RESEND_WEBHOOK_SECRET=""
# Domain that new mailbox addresses are created on (Settings > Mailboxes)
# MAIL_DOMAIN="hifimarketing.co"
# ANTHROPIC_API_KEY=
