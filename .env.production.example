# Copy to .env.production on the server and fill every value. Never commit the real file.
DB_PASSWORD=
SESSION_SECRET=            # 48+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_URL=https://erp.example.com
SETUP_TOKEN=               # 16+ random characters, only for the first run; delete after setup
# Optional
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# ANTHROPIC_API_KEY=
