generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity, organization, access control ----------

model Organization {
  id        String   @id @default(cuid())
  name      String
  baseCurrency String @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches    Branch[]
  departments Department[]
  users       User[]
  roles       Role[]
  profiles    CompanyProfile[]
  bankAccounts BankAccount[]
  auditLogs   AuditLog[]
  settingChanges SettingChange[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  kind           String   @default("OFFICE") // REGISTERED_OFFICE | SALES_CENTRE | OFFICE
  country        String?
  address        String?
  timezone       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]

  @@unique([organizationId, name])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]

  @@unique([organizationId, name])
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String    @unique
  name           String
  passwordHash   String
  active         Boolean   @default(true)
  userType       String    @default("EMPLOYEE") // EMPLOYEE | CLIENT | VENDOR | PARTNER | INVESTOR
  clientId       String?   // set for client portal users: the only client they can ever see
  vendorId       String?   // set for vendor portal users: the only vendor they can ever see
  branchId       String?
  departmentId   String?
  managerId      String?
  mustChangePassword Boolean @default(false)
  totpSecretEnc  String? // encrypted at rest
  totpEnabled    Boolean   @default(false)
  totpLastStep   Int? // last accepted 30-second step, so a code cannot be used twice
  calendarToken  String?   @unique // secret address of this person's calendar feed; null means no feed
  recoveryCodes  Json? // array of sha256 hashes of unused one-time codes
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  manager      User?        @relation("Reports", fields: [managerId], references: [id])
  reports      User[]       @relation("Reports")
  roles        UserRole[]
  sessions     Session[]
  auditLogs    AuditLog[]

  @@index([organizationId])
}

model Role {
  id             String  @id @default(cuid())
  organizationId String
  key            String // e.g. SUPER_ADMIN
  name           String
  isSystem       Boolean @default(false)
  requireMfa     Boolean @default(false) // everyone holding this role must use two-step verification

  organization Organization    @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, key])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. bank.view_full
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId  String
  roleId  String
  expiresAt DateTime? // temporary access delegation

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Governance ----------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String // e.g. bank_account.update
  entity         String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

// Configuration change history (who changed which setting, when, old/new)
model SettingChange {
  id             String   @id @default(cuid())
  organizationId String
  section        String
  actorId        String?
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, section, createdAt])
}

// ---------- Company settings ----------

// One row per legal entity / document profile. Edits create a new version;
// issued documents later store a snapshot, so old rows are never overwritten.
model CompanyProfile {
  id             String   @id @default(cuid())
  organizationId String
  isDefault      Boolean  @default(false)
  version        Int      @default(1)
  legalName      String
  tradingName    String?
  website        String?
  email          String?
  description    String?
  globalUan      String?
  localUan       String?
  registeredOffice String?
  salesCentre    String?
  registrationNo String?
  taxId          String?
  legalNotice    String?
  invoiceFooter  String?
  defaultCurrency String  @default("USD")
  timezone       String   @default("UTC")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String
  internalName   String
  bankName       String
  accountHolder  String
  country        String?
  branchName     String?
  accountNumber  String // shown masked unless bank.view_full
  iban           String?
  swift          String?
  routingCode    String?
  currency       String // PKR | USD | AED | GBP
  accountType    String   @default("CURRENT")
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  paymentInstructions String?
  verified       Boolean  @default(false) // manual entry never implies verified
  ledgerAccountId String?
  ledgerAccount  Account? @relation(fields: [ledgerAccountId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, currency])
}

// ---------- Phase 1: service catalog and CRM ----------

model ServiceCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)

  plans ServicePlan[]

  @@unique([organizationId, name])
}

model ServicePlan {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  name           String
  tagline        String?
  billingInterval String  @default("MONTHLY") // ONE_TIME | MONTHLY | QUARTERLY | ANNUAL | HOURLY | MILESTONE | CUSTOM
  isPopular      Boolean  @default(false)
  isPublic       Boolean  @default(true)
  active         Boolean  @default(true)
  version        Int      @default(1)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  prices   PlanPrice[]
  features PlanFeature[]
  leads    Lead[]

  @@index([organizationId, categoryId])
}

// Independent price per currency (never a converted copy of another currency)
model PlanPrice {
  id       String  @id @default(cuid())
  planId   String
  currency String
  amount   Decimal @db.Decimal(14, 2)
  setupFee Decimal? @db.Decimal(14, 2)

  plan ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency])
}

model PlanFeature {
  id        String  @id @default(cuid())
  planId    String
  text      String
  included  Boolean @default(true)
  sortOrder Int     @default(0)

  plan ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model PipelineStage {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int
  probability    Int     @default(0)
  isWon          Boolean @default(false)
  isLost         Boolean @default(false)

  leads Lead[]

  @@unique([organizationId, name])
}

model Lead {
  id             String   @id @default(cuid())
  organizationId String
  number         Int      @default(autoincrement())
  name           String
  company        String?
  email          String?
  phone          String?
  country        String?
  source         String?
  serviceInterest String?
  planId         String?
  dealValue      Decimal? @db.Decimal(14, 2)
  currency       String   @default("USD")
  priority       String   @default("MEDIUM")
  stageId        String
  stageChangedAt DateTime @default(now())
  assignedToId   String?
  nextFollowUp   DateTime?
  notes          String?
  createdById    String?
  clientId       String?
  convertedAt    DateTime?
  city           String?
  timezone       String?
  preferredContact String?  // CALL | WHATSAPP | EMAIL | SMS
  expectedCloseDate String? // YYYY-MM-DD
  tags           String[]  @default([])
  campaignId     String?
  lastContactAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client     Client?       @relation(fields: [clientId], references: [id])
  stage      PipelineStage @relation(fields: [stageId], references: [id])
  plan       ServicePlan?  @relation(fields: [planId], references: [id])
  activities LeadActivity[]

  @@index([organizationId, stageId])
  @@index([organizationId, assignedToId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  actorId   String?
  kind      String // NOTE | CALL | EMAIL | MEETING | FOLLOW_UP | PROPOSAL | APPOINTMENT | WHATSAPP | STAGE_CHANGE | CREATED
  outcome   String? // calls: NO_ANSWER | VOICEMAIL | CONNECTED | WRONG_NUMBER | NOT_INTERESTED
  verified  Boolean  @default(false) // a connected call counts toward targets only once a manager has verified it
  verifiedById String?
  body      String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// ---------- Phase 3: accounting core ----------

model NumberSequence {
  organizationId String
  key            String // INV, RCT, JE
  next           Int    @default(1)

  @@id([organizationId, key])
}

model Client {
  id             String   @id @default(cuid())
  organizationId String
  code           String? // assigned on creation, e.g. C-0001
  name           String
  email          String?
  phone          String?
  billingAddress String?
  country        String?
  taxId          String?
  currency       String   @default("USD")
  paymentTermsDays Int    @default(14)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  invoices Invoice[]
  quotes   Quote[]
  subscriptions Subscription[]
  contracts Contract[]
  payments Payment[]
  journalLines JournalLine[]
  leads    Lead[]
  invites  ClientInvite[]

  @@unique([organizationId, name])
}

model Account {
  id             String  @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String // ASSET | LIABILITY | EQUITY | REVENUE | DIRECT_COST | OPEX | OTHER_INCOME | OTHER_EXPENSE
  systemKey      String? // AR | TAX_PAYABLE | CUSTOMER_ADVANCES | REVENUE_SERVICE (used by automatic postings)
  active         Boolean @default(true)

  lines        JournalLine[]
  bankAccounts BankAccount[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
}

model JournalEntry {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  date           DateTime
  memo           String?
  currency       String
  status         String   @default("POSTED") // POSTED | REVERSED
  sourceType     String? // INVOICE | PAYMENT | MANUAL | REVERSAL
  sourceId       String?
  idempotencyKey String   @unique
  reversalOfId   String?  @unique
  postedById     String?
  createdAt      DateTime @default(now())

  lines JournalLine[]

  @@unique([organizationId, number])
  @@index([organizationId, date])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  clientId  String?
  vendorId  String?
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  memo      String?

  entry   JournalEntry @relation(fields: [entryId], references: [id])
  account Account      @relation(fields: [accountId], references: [id])
  client  Client?      @relation(fields: [clientId], references: [id])

  @@index([accountId])
  @@index([clientId])
  @@index([entryId])
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  number         String? // assigned when issued
  clientId       String
  status         String   @default("DRAFT") // DRAFT | ISSUED | PARTIALLY_PAID | PAID | CANCELLED
  currency       String
  issueDate      DateTime?
  dueDate        DateTime?
  subtotal       Decimal  @default(0) @db.Decimal(14, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2) // percent
  taxAmount      Decimal  @default(0) @db.Decimal(14, 2)
  total          Decimal  @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal  @default(0) @db.Decimal(14, 2)
  creditedAmount Decimal  @default(0) @db.Decimal(14, 2)
  projectId      String?
  notes          String?
  // Frozen at issue time so later settings changes never alter issued documents
  companySnapshot Json?
  bankSnapshot    Json?
  journalEntryId String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client      Client       @relation(fields: [clientId], references: [id])
  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]

  @@unique([organizationId, number])
  @@index([organizationId, clientId, status])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  clientId       String
  bankAccountId  String
  currency       String
  amount         Decimal  @db.Decimal(14, 2)
  unallocated    Decimal  @default(0) @db.Decimal(14, 2)
  date           DateTime
  method         String   @default("BANK_TRANSFER")
  reference      String?
  idempotencyKey String   @unique
  journalEntryId String?
  receivedById   String?
  bankSnapshot   Json?
  createdAt      DateTime @default(now())

  client      Client      @relation(fields: [clientId], references: [id])
  allocations PaymentAllocation[]

  @@unique([organizationId, number])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(14, 2)

  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

// ---------- Phase 2: projects and tasks ----------

model Project {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  name           String
  clientId       String?
  managerId      String
  status         String   @default("ACTIVE") // ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  priority       String   @default("MEDIUM")
  startDate      DateTime?
  deadline       DateTime?
  budgetAmount   Decimal? @db.Decimal(14, 2)
  currency       String   @default("USD")
  scope          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members ProjectMember[]
  tasks   Task[]
  milestones Milestone[]
  timeEntries TimeEntry[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model ProjectMember {
  projectId String
  userId    String
  role      String? // e.g. Graphic Designer
  hourlyCost Decimal? @db.Decimal(10, 2) // internal cost per hour in the project currency; restricted
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id             String   @id @default(cuid())
  projectId      String
  title          String
  description    String?
  status         String   @default("TODO") // TODO | IN_PROGRESS | REVIEW | DONE
  priority       String   @default("MEDIUM")
  assigneeId     String?
  dueDate        DateTime?
  estimatedHours Decimal? @db.Decimal(8, 2)
  clientVisible  Boolean  @default(false)
  milestoneId    String?
  blocked        Boolean  @default(false)
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  comments TaskComment[]

  @@index([projectId, status])
  @@index([assigneeId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  internal  Boolean  @default(true) // internal comments are never shown to clients
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ClientInvite {
  id        String    @id @default(cuid())
  clientId  String?
  vendorId  String?
  email     String
  tokenHash String    @unique // only the hash is stored; the link is shown once
  expiresAt DateTime
  usedAt    DateTime?
  createdById String?
  createdAt DateTime  @default(now())

  client Client? @relation(fields: [clientId], references: [id])
  vendor Vendor? @relation(fields: [vendorId], references: [id])

  @@index([clientId])
}

// ---------- Phase 4: HR ----------

model EmployeeProfile {
  id             String   @id @default(cuid())
  organizationId String
  userId         String   @unique
  employeeNo     String
  designation    String?
  departmentId   String?
  employmentType String   @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | INTERN
  workLocation   String   @default("OFFICE") // OFFICE | REMOTE | HYBRID | FIELD
  joinDate       DateTime?
  probationEnd   DateTime?
  phone          String?
  personalEmail  String?
  address        String?
  emergencyContact String?
  // Sensitive: only users with hr.view_sensitive may read these
  identityNumber String?
  bankDetails    String?
  status         String   @default("ACTIVE") // ACTIVE | EXITED
  exitDate       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, employeeNo])
}

model AttendanceRecord {
  id        String    @id @default(cuid())
  userId    String
  workDate  String // YYYY-MM-DD in the company timezone
  clockIn   DateTime
  clockOut  DateTime?
  workMode  String    @default("OFFICE") // OFFICE | REMOTE
  note      String?
  correctedById String?

  breaks BreakRecord[]

  @@unique([userId, workDate])
  @@index([workDate])
}

model BreakRecord {
  id           String   @id @default(cuid())
  attendanceId String
  startAt      DateTime
  endAt        DateTime?

  attendance AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model LeaveType {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  daysPerYear    Decimal @db.Decimal(5, 1)
  paid           Boolean @default(true)
  active         Boolean @default(true)

  requests LeaveRequest[]

  @@unique([organizationId, name])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  userId      String
  leaveTypeId String
  startDate   String // YYYY-MM-DD
  endDate     String // YYYY-MM-DD
  days        Decimal   @db.Decimal(5, 1) // working days, weekends excluded
  reason      String?
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  approverId  String?
  decidedAt   DateTime?
  decisionNote String?
  createdAt   DateTime  @default(now())

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([userId, status])
}

// ---------- Phase 4: payroll ----------

model SalaryStructure {
  id            String   @id @default(cuid())
  userId        String
  effectiveFrom String // YYYY-MM-DD
  currency      String
  basic         Decimal  @db.Decimal(14, 2)
  allowance     Decimal  @default(0) @db.Decimal(14, 2)
  taxPercent    Decimal  @default(0) @db.Decimal(5, 2) // flat withholding; replace with jurisdiction rules later
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([userId, effectiveFrom])
  @@index([userId])
}

model PayrollRun {
  id             String   @id @default(cuid())
  organizationId String
  period         String // YYYY-MM
  currency       String
  status         String   @default("DRAFT") // DRAFT | APPROVED | POSTED | PAID
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  postedAt       DateTime?
  paidAt         DateTime?
  journalEntryId String?
  paymentEntryId String?
  createdAt      DateTime @default(now())

  items PayrollItem[]

  @@unique([organizationId, period, currency])
}

model PayrollItem {
  id              String  @id @default(cuid())
  runId           String
  userId          String
  workingDays     Int
  unpaidDays      Decimal @db.Decimal(5, 1)
  basic           Decimal @db.Decimal(14, 2)
  allowance       Decimal @db.Decimal(14, 2)
  bonus           Decimal @default(0) @db.Decimal(14, 2)
  unpaidDeduction Decimal @db.Decimal(14, 2)
  gross           Decimal @db.Decimal(14, 2)
  taxPercent      Decimal @db.Decimal(5, 2)
  tax             Decimal @db.Decimal(14, 2)
  net             Decimal @db.Decimal(14, 2)

  run PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
}

// ---------- Phase 3: expenses and budgets ----------

model Budget {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  scope          String   @default("COMPANY") // COMPANY | DEPARTMENT | PROJECT
  projectId      String?
  departmentId   String?
  periodStart    String // YYYY-MM-DD
  periodEnd      String
  currency       String
  originalAmount Decimal  @db.Decimal(14, 2) // never overwritten; transfers are tracked separately
  createdById    String?
  createdAt      DateTime @default(now())

  vouchers     ExpenseVoucher[]
  transfersOut BudgetTransfer[] @relation("from")
  transfersIn  BudgetTransfer[] @relation("to")

  @@index([organizationId])
}

model BudgetTransfer {
  id           String    @id @default(cuid())
  fromBudgetId String
  toBudgetId   String
  amount       Decimal   @db.Decimal(14, 2)
  reason       String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedById String
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  from Budget @relation("from", fields: [fromBudgetId], references: [id])
  to   Budget @relation("to", fields: [toBudgetId], references: [id])
}

model ExpenseVoucher {
  id               String   @id @default(cuid())
  organizationId   String
  number           String
  date             String // YYYY-MM-DD
  payee            String
  description      String
  justification    String?
  expenseAccountId String
  projectId        String?
  budgetId         String?
  currency         String
  amount           Decimal  @db.Decimal(14, 2)
  status           String   @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | POSTED | PAID | REJECTED | CANCELLED
  submittedById    String
  reviewedById     String?
  approvedById     String?
  decisionNote     String?
  overBudgetReason String?
  journalEntryId   String?
  paymentEntryId   String?
  paidById         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  budget Budget? @relation(fields: [budgetId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([submittedById])
}

// ---------- Phase 5: vendors and procurement ----------

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  email          String?
  phone          String?
  country        String?
  currency       String   @default("USD")
  categories     String? // comma separated service categories
  paymentTermsDays Int    @default(30)
  status         String   @default("PENDING") // PENDING | APPROVED | SUSPENDED
  bankDetails    String? // restricted
  internalNotes  String?
  createdAt      DateTime @default(now())

  applications VendorApplication[]
  workOrders   WorkOrder[]
  bills        VendorBill[]
  invites      ClientInvite[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
}

model VendorOpportunity {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  scope          String
  skills         String?
  budgetMin      Decimal? @db.Decimal(14, 2)
  budgetMax      Decimal? @db.Decimal(14, 2)
  currency       String   @default("USD")
  deadline       String? // YYYY-MM-DD application deadline
  status         String   @default("OPEN") // OPEN | CLOSED | AWARDED
  createdById    String?
  createdAt      DateTime @default(now())

  applications VendorApplication[]
}

model VendorApplication {
  id            String   @id @default(cuid())
  opportunityId String
  vendorId      String
  quoteAmount   Decimal  @db.Decimal(14, 2)
  proposal      String?
  status        String   @default("SUBMITTED") // SUBMITTED | SHORTLISTED | APPROVED | REJECTED
  decidedById   String?
  createdAt     DateTime @default(now())

  opportunity VendorOpportunity @relation(fields: [opportunityId], references: [id])
  vendor      Vendor            @relation(fields: [vendorId], references: [id])

  @@unique([opportunityId, vendorId])
}

model WorkOrder {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  vendorId       String
  applicationId  String?  @unique
  projectId      String?
  title          String
  scope          String?
  amount         Decimal  @db.Decimal(14, 2)
  currency       String
  status         String   @default("ISSUED") // ISSUED | DELIVERED | ACCEPTED | CANCELLED
  issuedById     String?
  acceptedById   String?
  createdAt      DateTime @default(now())

  vendor Vendor       @relation(fields: [vendorId], references: [id])
  bills  VendorBill[]

  @@unique([organizationId, number])
}

model VendorBill {
  id               String   @id @default(cuid())
  organizationId   String
  number           String
  vendorId         String
  workOrderId      String
  vendorReference  String?
  amount           Decimal  @db.Decimal(14, 2)
  currency         String
  expenseAccountId String?
  status           String   @default("SUBMITTED") // SUBMITTED | APPROVED | POSTED | PAID | REJECTED
  approvedById     String?
  decisionNote     String?
  journalEntryId   String?
  paymentEntryId   String?
  createdAt        DateTime @default(now())

  vendor    Vendor    @relation(fields: [vendorId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@unique([organizationId, number])
  @@index([vendorId])
}

// ---------- Phase 5: fixed assets and investments ----------

model Asset {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  name           String
  category       String?
  serialNumber   String?
  supplier       String?
  purchaseDate   String // YYYY-MM-DD
  cost           Decimal  @db.Decimal(14, 2)
  salvageValue   Decimal  @default(0) @db.Decimal(14, 2)
  currency       String
  usefulLifeMonths Int
  location       String?
  status         String   @default("ACTIVE") // ACTIVE | DISPOSED
  assignedToId   String?
  purchaseEntryId String?
  disposedDate   String?
  disposalProceeds Decimal? @db.Decimal(14, 2)
  disposalEntryId String?
  createdAt      DateTime @default(now())

  depreciation DepreciationEntry[]
  assignments  AssetAssignment[]

  @@unique([organizationId, number])
}

model DepreciationEntry {
  id             String   @id @default(cuid())
  assetId        String
  period         String // YYYY-MM
  amount         Decimal  @db.Decimal(14, 2)
  journalEntryId String?

  asset Asset @relation(fields: [assetId], references: [id])

  @@unique([assetId, period])
}

model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  userId     String
  assignedAt DateTime  @default(now())
  returnedAt DateTime?

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([assetId])
}

model Investment {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  name           String
  category       String?
  investee       String
  currency       String
  investmentDate String
  ownershipPct   Decimal? @db.Decimal(5, 2)
  expectedReturn String?
  status         String   @default("ACTIVE") // ACTIVE | EXITED
  createdAt      DateTime @default(now())

  transactions InvestmentTransaction[]

  @@unique([organizationId, number])
}

model InvestmentTransaction {
  id             String   @id @default(cuid())
  investmentId   String
  kind           String // CAPITAL | INCOME_RECOGNISED | INCOME_RECEIVED
  amount         Decimal  @db.Decimal(14, 2)
  date           String
  note           String?
  journalEntryId String?
  createdById    String?
  createdAt      DateTime @default(now())

  investment Investment @relation(fields: [investmentId], references: [id])

  @@index([investmentId])
}

// ---------- Notifications, content calendar, prospecting worklists ----------

model Notification {
  id          String    @id @default(cuid())
  userId      String
  kind        String
  title       String
  body        String?
  link        String?
  dedupeKey   String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model ContentItem {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  projectId      String?
  platform       String // FACEBOOK | INSTAGRAM | TIKTOK | LINKEDIN | YOUTUBE | OTHER
  title          String
  copy           String
  hashtags       String?
  plannedDate    String? // YYYY-MM-DD
  status         String   @default("DRAFT") // DRAFT | INTERNAL_REVIEW | CLIENT_REVIEW | CHANGES_REQUESTED | APPROVED | SCHEDULED | PUBLISHED
  version        Int      @default(1)
  assignedToId   String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events   ContentEvent[]
  versions ContentVersion[]

  @@index([organizationId, status])
  @@index([clientId, status])
}

model ContentVersion {
  id        String   @id @default(cuid())
  itemId    String
  version   Int
  copy      String
  hashtags  String?
  createdAt DateTime @default(now())

  item ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, version])
}

model ContentEvent {
  id         String   @id @default(cuid())
  itemId     String
  actorId    String
  actorType  String // STAFF | CLIENT
  fromStatus String?
  toStatus   String
  comment    String?
  createdAt  DateTime @default(now())

  item ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model SuppressedContact {
  id             String   @id @default(cuid())
  organizationId String
  email          String?
  phone          String?
  reason         String?
  createdAt      DateTime @default(now())

  @@index([organizationId, email])
  @@index([organizationId, phone])
}

model Worklist {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  source         String?
  assignedToId   String?
  targetDate     String?
  createdById    String
  createdAt      DateTime @default(now())

  rows WorklistRow[]
}

model WorklistRow {
  id             String   @id @default(cuid())
  worklistId     String
  rowNumber      Int // original row in the source file
  name           String
  company        String?
  email          String?
  phone          String?
  raw            Json
  status         String   @default("NEW") // NEW | CONTACTED | NOT_INTERESTED | DO_NOT_CONTACT | CONVERTED
  note           String?
  duplicateLeadId String?
  convertedLeadId String?
  updatedAt      DateTime @updatedAt

  worklist Worklist @relation(fields: [worklistId], references: [id], onDelete: Cascade)

  @@index([worklistId, status])
}

// ---------- Accountant essentials ----------

model PeriodLock {
  organizationId String   @id
  lockedThrough  String // YYYY-MM-DD: nothing may be posted on or before this date
  lockedById     String?
  updatedAt      DateTime @updatedAt
}

model ManualJournal {
  id             String   @id @default(cuid())
  organizationId String
  date           String // YYYY-MM-DD
  memo           String
  currency       String
  lines          Json // [{ accountId, debit, credit, memo }]
  status         String   @default("PENDING") // PENDING | POSTED | REJECTED
  createdById    String
  decidedById    String?
  decisionNote   String?
  journalEntryId String?
  createdAt      DateTime @default(now())

  @@index([organizationId, status])
}

model CreditNote {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  invoiceId      String
  clientId       String
  amount         Decimal  @db.Decimal(14, 2)
  taxPortion     Decimal  @db.Decimal(14, 2)
  currency       String
  reason         String
  kind           String   @default("CREDIT") // CREDIT | WRITE_OFF
  idempotencyKey String   @unique
  journalEntryId String?
  createdById    String
  createdAt      DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([organizationId, number])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// ---------- File storage and document settings ----------

model StoredFile {
  id             String    @id @default(cuid())
  organizationId String
  ownerType      String // EXPENSE | VENDOR_BILL | CONTENT | EMPLOYEE
  ownerId        String
  filename       String // display name only; never used as a path
  contentType    String // decided by the server from the file contents, not by the uploader
  size           Int
  sha256         String
  storageKey     String    @unique // random; where the bytes live in the storage provider
  category       String?
  expiresOn      String? // YYYY-MM-DD, for documents that lapse (employee IDs, contracts)
  scanStatus     String    @default("UNSCANNED") // UNSCANNED | CLEAN | INFECTED
  uploadedById   String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  deletedById    String?

  @@index([organizationId, ownerType, ownerId])
}

model DocumentSetting {
  id             String   @id @default(cuid())
  organizationId String
  docType        String // INVOICE | RECEIPT | CREDIT_NOTE | STATEMENT | PAYSLIP | VOUCHER
  config         Json
  version        Int      @default(1)
  updatedById    String?
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, docType])
}

// Rate meaning: 1 unit of `currency` = `rate` units of the organization's base currency, valid from `effectiveDate`.
// Rows are never edited; a correction is a new row for the same date (the latest entry wins) so history stays traceable.
model ExchangeRate {
  id             String   @id @default(cuid())
  organizationId String
  currency       String
  rate           Decimal  @db.Decimal(18, 8)
  effectiveDate  String   // YYYY-MM-DD
  source         String   @default("MANUAL")
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([organizationId, currency, effectiveDate])
}

// ---------- Quotations, subscriptions, contracts ----------

model Quote {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  clientId       String
  status         String   @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED | EXPIRED | INVOICED | CANCELLED
  currency       String
  validUntil     String?  // YYYY-MM-DD
  subtotal       Decimal  @default(0) @db.Decimal(14, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(14, 2)
  total          Decimal  @default(0) @db.Decimal(14, 2)
  notes          String?
  terms          String?
  sentAt         DateTime?
  decidedAt      DateTime?
  decidedById    String?
  decidedVia     String?  // PORTAL | STAFF
  decisionNote   String?
  invoiceId      String?  @unique
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client      @relation(fields: [clientId], references: [id])
  lines  QuoteLine[]

  @@unique([organizationId, number])
  @@index([organizationId, clientId, status])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)
  planId      String? // set when the line came from a catalog plan
  planVersion Int?    // the plan version whose price was used

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// A recurring charge. Each due period creates one draft invoice for a person to review and issue.
model Subscription {
  id              String   @id @default(cuid())
  organizationId  String
  clientId        String
  name            String
  currency        String
  amount          Decimal  @db.Decimal(14, 2) // per billing period, before tax
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  interval        String   @default("MONTHLY") // MONTHLY | QUARTERLY | ANNUAL
  startDate       String   // YYYY-MM-DD
  endDate         String?
  nextBillingDate String?  // null once the subscription has run its course
  cyclesBilled    Int      @default(0)
  status          String   @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED | ENDED
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client   Client                @relation(fields: [clientId], references: [id])
  invoices SubscriptionInvoice[]

  @@index([organizationId, status, nextBillingDate])
}

model SubscriptionInvoice {
  id             String   @id @default(cuid())
  subscriptionId String
  periodStart    String
  invoiceId      String   @unique
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, periodStart])
}

model Contract {
  id               String   @id @default(cuid())
  organizationId   String
  clientId         String
  title            String
  status           String   @default("DRAFT") // DRAFT | ACTIVE | EXPIRED | TERMINATED
  startDate        String?
  endDate          String?
  renewalNoticeDays Int     @default(30)
  currency         String?
  value            Decimal? @db.Decimal(14, 2)
  notes            String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@index([organizationId, status, endDate])
}

// ---------- Project depth: milestones, time, profitability ----------

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  dueDate     String?   // YYYY-MM-DD
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | DONE
  amount      Decimal?  @db.Decimal(14, 2) // what is billed to the client when this milestone is done
  invoiceId   String?   @unique
  sortOrder   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, sortOrder])
}

model TimeEntry {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  taskId         String?
  userId         String
  workDate       String   // YYYY-MM-DD
  hours          Decimal  @db.Decimal(5, 2)
  note           String?
  hourlyCost     Decimal? @db.Decimal(10, 2) // the member's cost rate when the time was logged, so later rate changes never rewrite history
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, workDate])
  @@index([userId, workDate])
}

// ---------- Bank reconciliation and year-end close ----------

model BankStatementLine {
  id             String   @id @default(cuid())
  organizationId String
  bankAccountId  String
  date           String   // YYYY-MM-DD
  description    String
  reference      String?
  amount         Decimal  @db.Decimal(14, 2) // positive = money in, negative = money out
  dedupKey       String   // the same line imported twice is recognised and skipped
  importedById   String?
  createdAt      DateTime @default(now())

  @@unique([bankAccountId, dedupKey])
  @@index([organizationId, bankAccountId, date])
}

// Links one bank statement line to one ledger line (or clears a ledger line as part of the opening position).
model BankMatch {
  id              String   @id @default(cuid())
  organizationId  String
  bankAccountId   String
  statementLineId String?  @unique
  journalLineId   String   @unique
  kind            String   @default("STATEMENT") // STATEMENT | OPENING
  matchedById     String?
  reconciliationId String?
  createdAt       DateTime @default(now())

  @@index([bankAccountId])
}

model BankReconciliation {
  id                 String   @id @default(cuid())
  organizationId     String
  bankAccountId      String
  statementDate      String
  statementBalance   Decimal  @db.Decimal(14, 2)
  ledgerBalance      Decimal  @db.Decimal(14, 2)
  outstandingLedger  Decimal  @db.Decimal(14, 2) // ledger lines not on the statement (signed)
  unmatchedStatement Decimal  @db.Decimal(14, 2) // statement lines not in the ledger (signed)
  difference         Decimal  @db.Decimal(14, 2)
  completedById      String?
  createdAt          DateTime @default(now())

  @@index([organizationId, bankAccountId, statementDate])
}

// Named tax rates offered when writing invoices, quotations and subscriptions. An invoice still stores the percentage it was issued with.
model TaxRate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  ratePercent    Decimal  @db.Decimal(5, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
}

// Every email the system tries to send. The status is only SENT when the mail server accepted the message;
// with no mail account configured the status is NOT_CONFIGURED and nothing is claimed as delivered.
model EmailMessage {
  id                String   @id @default(cuid())
  organizationId    String
  toEmail           String
  subject           String
  body              String
  attachmentName    String?
  relatedType       String?  // INVOICE | QUOTE | STATEMENT | TEST
  relatedId         String?
  status            String   // SENT | FAILED | NOT_CONFIGURED
  error             String?
  providerMessageId String?
  createdById       String?
  createdAt         DateTime @default(now())
  sentAt            DateTime?

  @@index([organizationId, createdAt])
  @@index([relatedType, relatedId])
}

// ---------- Commissions and incentives ----------

// A salesperson earns this percentage of the revenue (before tax) from clients they converted, as payments arrive.
model CommissionRule {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  ratePercent    Decimal  @db.Decimal(5, 2)
  active         Boolean  @default(true)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
}

model CommissionEntry {
  id               String    @id @default(cuid())
  organizationId   String
  userId           String
  kind             String    @default("COMMISSION") // COMMISSION | BONUS
  allocationId     String?   @unique // the payment allocation that earned it, so one payment is never commissioned twice
  invoiceId        String?
  clientId         String?
  currency         String
  base             Decimal   @default(0) @db.Decimal(14, 2) // revenue the percentage was applied to
  ratePercent      Decimal   @default(0) @db.Decimal(5, 2)
  amount           Decimal   @db.Decimal(14, 2)
  note             String?
  status           String    @default("EARNED") // EARNED | APPROVED | PAID | VOID
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  accrualEntryId   String?
  paidById         String?
  paidAt           DateTime?
  paymentEntryId   String?
  createdAt        DateTime  @default(now())

  @@index([organizationId, status])
  @@index([userId, createdAt])
}

// What people asked the assistant and which data it read, for audit. Answers are not stored: they are rebuilt from live data when asked again.
model AssistantLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  question       String
  toolsUsed      String[]
  status         String   // ANSWERED | FAILED | NOT_CONFIGURED
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// ---------- CRM depth: campaigns, smart lists, sales targets ----------

model Campaign {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  channel        String   @default("OTHER") // FACEBOOK | INSTAGRAM | LINKEDIN | GOOGLE | EMAIL | REFERRAL | COLD_CALLING | EVENT | OTHER
  status         String   @default("ACTIVE") // PLANNED | ACTIVE | PAUSED | DONE
  budget         Decimal? @db.Decimal(14, 2)
  currency       String   @default("USD")
  startDate      String?
  endDate        String?
  notes          String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
}

// Saved filters over leads. Private to the owner unless shared with everyone who can open the Leads screen.
model SmartList {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String
  name           String
  filters        Json
  shared         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([organizationId, ownerId, name])
}

// Daily and monthly goals per person and activity type, for example 80 connected calls a day.
model SalesTarget {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  metric         String   // CALLS | CONNECTED_CALLS | EMAILS | MEETINGS | FOLLOW_UPS | PROPOSALS | CONVERSIONS
  daily          Int?
  monthly        Int?
  updatedById    String?
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId, metric])
}

// ---------- Work activity monitoring (transparent, consent-based; see docs/MONITORING.md) ----------

// Off until an administrator turns it on. Changing what is collected raises the version, and everyone must read and accept the new version before anything is recorded about them.
model MonitoringPolicy {
  organizationId       String   @id
  version              Int      @default(1)
  enabled              Boolean  @default(false)
  policyText           String   @default("")
  trackActivity        Boolean  @default(true)  // aggregate active/idle time and key and click COUNTS (never what was typed)
  trackApps            Boolean  @default(false) // names of applications used, as durations
  screenshots          Boolean  @default(false)
  screenshotIntervalMin Int     @default(10)
  idleThresholdMin     Int      @default(5)
  timezone             String   @default("Asia/Karachi") // working hours below are in this time zone
  workStart            String   @default("09:00")
  workEnd              String   @default("18:00")
  workDays             String   @default("1,2,3,4,5") // 0 = Sunday
  retentionDays        Int      @default(30)
  updatedById          String?
  updatedAt            DateTime @updatedAt
}

model PolicyAck {
  id        String   @id @default(cuid())
  userId    String
  version   Int
  createdAt DateTime @default(now())

  @@unique([userId, version])
}

model WorkSession {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  lastBeatAt     DateTime  @default(now())
  source         String    @default("WEB") // WEB | AGENT
  projectId      String?
  taskId         String?
  note           String?

  breaks WorkBreak[]

  @@index([userId, startedAt])
  @@index([organizationId, startedAt])
}

model WorkBreak {
  id        String    @id @default(cuid())
  sessionId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  session WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// Totals for a five-minute window. Counts only: no content, no key names, no pointer positions.
model ActivityBucket {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  bucketStart    DateTime
  activeSeconds  Int      @default(0)
  idleSeconds    Int      @default(0)
  keyCount       Int      @default(0)
  clickCount     Int      @default(0)
  source         String   @default("WEB")

  @@unique([userId, bucketStart, source])
  @@index([organizationId, bucketStart])
}

model AppUsage {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  day            String // YYYY-MM-DD
  name           String // application name only, never window titles or addresses
  seconds        Int    @default(0)

  @@unique([userId, day, name])
  @@index([organizationId, day])
}

model AppCategory {
  id             String @id @default(cuid())
  organizationId String
  pattern        String // matched against the application name, case-insensitive
  category       String // PRODUCTIVE | NEUTRAL | UNPRODUCTIVE

  @@unique([organizationId, pattern])
}

model MonitorDevice {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  name           String
  os             String?
  agentVersion   String?
  tokenHash      String    @unique
  enrolledAt     DateTime  @default(now())
  lastSeenAt     DateTime?
  revokedAt      DateTime?

  @@index([userId])
}

model EnrollmentCode {
  id          String    @id @default(cuid())
  userId      String
  codeHash    String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
}

model Screenshot {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  deviceId       String?
  capturedAt     DateTime
  storageKey     String    @unique
  contentType    String
  size           Int
  sha256         String
  disputed       Boolean   @default(false)
  disputeNote    String?
  deletedAt      DateTime?

  @@index([userId, capturedAt])
  @@index([organizationId, capturedAt])
}

// Every time someone other than the employee opens a screenshot or a detailed report, so employees can see who looked.
model MonitoringAccess {
  id             String   @id @default(cuid())
  organizationId String
  viewerId       String
  subjectId      String
  what           String   // SCREENSHOT | REPORT
  targetId       String?
  createdAt      DateTime @default(now())

  @@index([subjectId, createdAt])
}

model TimesheetCorrection {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  day            String    // YYYY-MM-DD
  requestedMinutes Int     // tracked minutes the employee says the day should show
  reason         String
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime  @default(now())

  @@index([organizationId, status])
  @@index([userId, day])
}
