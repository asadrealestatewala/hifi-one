generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity, organization, access control ----------

model Organization {
  id           String   @id @default(cuid())
  name         String
  baseCurrency String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branches       Branch[]
  departments    Department[]
  users          User[]
  roles          Role[]
  profiles       CompanyProfile[]
  bankAccounts   BankAccount[]
  auditLogs      AuditLog[]
  settingChanges SettingChange[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  kind           String   @default("OFFICE") // REGISTERED_OFFICE | SALES_CENTRE | OFFICE
  country        String?
  address        String?
  timezone       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]

  @@unique([organizationId, name])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]

  @@unique([organizationId, name])
}

model User {
  id                 String    @id @default(cuid())
  organizationId     String
  email              String?   @unique // official email; optional because some staff have none yet (never invented)
  phone              String?   @unique // registered contact number in E.164 (+923001234567); can be used to sign in
  emailVerifiedAt    DateTime? // set when the person proves they receive mail there, or an administrator confirms it
  phoneVerifiedAt    DateTime? // set when an administrator confirms the number (no SMS provider is configured)
  name               String
  passwordHash       String
  active             Boolean   @default(true)
  userType           String    @default("EMPLOYEE") // EMPLOYEE | CLIENT | VENDOR | PARTNER | INVESTOR
  clientId           String? // set for client portal users: the only client they can ever see
  vendorId           String? // set for vendor portal users: the only vendor they can ever see
  branchId           String?
  departmentId       String?
  managerId          String?
  mustChangePassword Boolean   @default(false)
  totpSecretEnc      String? // encrypted at rest
  totpEnabled        Boolean   @default(false)
  totpLastStep       Int? // last accepted 30-second step, so a code cannot be used twice
  calendarToken      String?   @unique // secret address of this person's calendar feed; null means no feed
  recoveryCodes      Json? // array of sha256 hashes of unused one-time codes
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  branch          Branch?          @relation(fields: [branchId], references: [id])
  department      Department?      @relation(fields: [departmentId], references: [id])
  manager         User?            @relation("Reports", fields: [managerId], references: [id])
  reports         User[]           @relation("Reports")
  roles           UserRole[]
  sessions        Session[]
  auditLogs       AuditLog[]
  campaigns       CampaignMember[]
  employeeProfile EmployeeProfile?

  @@index([organizationId])
}

model Role {
  id             String  @id @default(cuid())
  organizationId String
  key            String // e.g. SUPER_ADMIN
  name           String
  isSystem       Boolean @default(false)
  requireMfa     Boolean @default(false) // everyone holding this role must use two-step verification

  organization Organization     @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, key])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. bank.view_full
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String
  roleId    String
  expiresAt DateTime? // temporary access delegation

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Governance ----------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String // e.g. bank_account.update
  entity         String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

// Configuration change history (who changed which setting, when, old/new)
model SettingChange {
  id             String   @id @default(cuid())
  organizationId String
  section        String
  actorId        String?
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, section, createdAt])
}

// ---------- Company settings ----------

// One row per legal entity / document profile. Edits create a new version;
// issued documents later store a snapshot, so old rows are never overwritten.
model CompanyProfile {
  id               String   @id @default(cuid())
  organizationId   String
  isDefault        Boolean  @default(false)
  version          Int      @default(1)
  legalName        String
  tradingName      String?
  website          String?
  email            String?
  description      String?
  globalUan        String?
  localUan         String?
  registeredOffice String?
  salesCentre      String?
  registrationNo   String?
  taxId            String?
  legalNotice      String?
  invoiceFooter    String?
  defaultCurrency  String   @default("USD")
  timezone         String   @default("UTC")
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model BankAccount {
  id                  String   @id @default(cuid())
  organizationId      String
  internalName        String
  bankName            String
  accountHolder       String
  country             String?
  branchName          String?
  accountNumber       String // shown masked unless bank.view_full
  iban                String?
  swift               String?
  routingCode         String?
  currency            String // PKR | USD | AED | GBP
  accountType         String   @default("CURRENT")
  isDefault           Boolean  @default(false)
  active              Boolean  @default(true)
  paymentInstructions String?
  verified            Boolean  @default(false) // manual entry never implies verified
  ledgerAccountId     String?
  ledgerAccount       Account? @relation(fields: [ledgerAccountId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, currency])
}

// ---------- Phase 1: service catalog and CRM ----------

model ServiceCategory {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int     @default(0)
  active         Boolean @default(true)

  plans     ServicePlan[]
  campaigns Campaign[]

  @@unique([organizationId, name])
}

model ServicePlan {
  id              String   @id @default(cuid())
  organizationId  String
  categoryId      String
  name            String
  tagline         String?
  billingInterval String   @default("MONTHLY") // ONE_TIME | MONTHLY | QUARTERLY | ANNUAL | HOURLY | MILESTONE | CUSTOM
  isPopular       Boolean  @default(false)
  isPublic        Boolean  @default(true)
  active          Boolean  @default(true)
  version         Int      @default(1)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  prices   PlanPrice[]
  features PlanFeature[]
  leads    Lead[]

  @@index([organizationId, categoryId])
}

// Independent price per currency (never a converted copy of another currency)
model PlanPrice {
  id       String   @id @default(cuid())
  planId   String
  currency String
  amount   Decimal  @db.Decimal(14, 2)
  setupFee Decimal? @db.Decimal(14, 2)

  plan ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency])
}

model PlanFeature {
  id        String  @id @default(cuid())
  planId    String
  text      String
  included  Boolean @default(true)
  sortOrder Int     @default(0)

  plan ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model PipelineStage {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int
  probability    Int     @default(0)
  isWon          Boolean @default(false)
  isLost         Boolean @default(false)

  leads Lead[]

  @@unique([organizationId, name])
}

model Lead {
  id                String    @id @default(cuid())
  organizationId    String
  number            Int       @default(autoincrement())
  name              String
  company           String?
  email             String?
  phone             String?
  country           String?
  source            String?
  serviceInterest   String?
  planId            String?
  dealValue         Decimal?  @db.Decimal(14, 2)
  currency          String    @default("USD")
  priority          String    @default("MEDIUM")
  stageId           String
  stageChangedAt    DateTime  @default(now())
  assignedToId      String?
  nextFollowUp      DateTime?
  notes             String?
  createdById       String?
  clientId          String?
  convertedAt       DateTime?
  contactId         String? // the contact record this lead belongs to; kept in sync
  city              String?
  timezone          String?
  preferredContact  String? // CALL | WHATSAPP | EMAIL | SMS
  expectedCloseDate String? // YYYY-MM-DD
  tags              String[]  @default([])
  campaignId        String?
  leadSourceId      String? // the website form or webhook that captured it
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  landingUrl        String?
  lastContactAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client     Client?              @relation(fields: [clientId], references: [id])
  stage      PipelineStage        @relation(fields: [stageId], references: [id])
  plan       ServicePlan?         @relation(fields: [planId], references: [id])
  activities LeadActivity[]
  followUps  FollowUpEnrollment[]

  @@index([organizationId, stageId])
  @@index([organizationId, assignedToId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
}

model LeadActivity {
  id           String   @id @default(cuid())
  leadId       String
  actorId      String?
  kind         String // NOTE | CALL | EMAIL | MEETING | FOLLOW_UP | PROPOSAL | APPOINTMENT | WHATSAPP | STAGE_CHANGE | CREATED
  outcome      String? // calls: NO_ANSWER | VOICEMAIL | CONNECTED | WRONG_NUMBER | NOT_INTERESTED
  verified     Boolean  @default(false) // a connected call counts toward targets only once a manager has verified it
  verifiedById String?
  body         String?
  createdAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// ---------- Phase 3: accounting core ----------

model NumberSequence {
  organizationId String
  key            String // INV, RCT, JE
  next           Int    @default(1)

  @@id([organizationId, key])
}

model Client {
  id               String   @id @default(cuid())
  organizationId   String
  code             String? // assigned on creation, e.g. C-0001
  name             String
  email            String?
  phone            String?
  billingAddress   String?
  country          String?
  taxId            String?
  currency         String   @default("USD")
  paymentTermsDays Int      @default(14)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  contactId     String?
  invoices      Invoice[]
  quotes        Quote[]
  subscriptions Subscription[]
  contracts     Contract[]
  payments      Payment[]
  journalLines  JournalLine[]
  leads         Lead[]
  invites       ClientInvite[]
  campaigns     CampaignClient[]

  @@unique([organizationId, name])
}

model Account {
  id             String  @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String // ASSET | LIABILITY | EQUITY | REVENUE | DIRECT_COST | OPEX | OTHER_INCOME | OTHER_EXPENSE
  systemKey      String? // AR | TAX_PAYABLE | CUSTOMER_ADVANCES | REVENUE_SERVICE (used by automatic postings)
  active         Boolean @default(true)

  lines        JournalLine[]
  bankAccounts BankAccount[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
}

model JournalEntry {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  date           DateTime
  memo           String?
  currency       String
  status         String   @default("POSTED") // POSTED | REVERSED
  sourceType     String? // INVOICE | PAYMENT | MANUAL | REVERSAL
  sourceId       String?
  idempotencyKey String   @unique
  reversalOfId   String?  @unique
  postedById     String?
  createdAt      DateTime @default(now())

  lines JournalLine[]

  @@unique([organizationId, number])
  @@index([organizationId, date])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  clientId  String?
  vendorId  String?
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  memo      String?

  entry   JournalEntry @relation(fields: [entryId], references: [id])
  account Account      @relation(fields: [accountId], references: [id])
  client  Client?      @relation(fields: [clientId], references: [id])

  @@index([accountId])
  @@index([clientId])
  @@index([entryId])
}

model Invoice {
  id              String    @id @default(cuid())
  organizationId  String
  number          String? // assigned when issued
  clientId        String
  status          String    @default("DRAFT") // DRAFT | ISSUED | PARTIALLY_PAID | PAID | CANCELLED
  currency        String
  issueDate       DateTime?
  dueDate         DateTime?
  subtotal        Decimal   @default(0) @db.Decimal(14, 2)
  taxRate         Decimal   @default(0) @db.Decimal(5, 2) // percent
  taxAmount       Decimal   @default(0) @db.Decimal(14, 2)
  total           Decimal   @default(0) @db.Decimal(14, 2)
  amountPaid      Decimal   @default(0) @db.Decimal(14, 2)
  creditedAmount  Decimal   @default(0) @db.Decimal(14, 2)
  projectId       String?
  notes           String?
  // Frozen at issue time so later settings changes never alter issued documents
  companySnapshot Json?
  bankSnapshot    Json?
  journalEntryId  String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client      Client              @relation(fields: [clientId], references: [id])
  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]

  @@unique([organizationId, number])
  @@index([organizationId, clientId, status])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  clientId       String
  bankAccountId  String
  currency       String
  amount         Decimal  @db.Decimal(14, 2)
  unallocated    Decimal  @default(0) @db.Decimal(14, 2)
  date           DateTime
  method         String   @default("BANK_TRANSFER")
  reference      String?
  idempotencyKey String   @unique
  journalEntryId String?
  receivedById   String?
  bankSnapshot   Json?
  createdAt      DateTime @default(now())

  client      Client              @relation(fields: [clientId], references: [id])
  allocations PaymentAllocation[]

  @@unique([organizationId, number])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(14, 2)

  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

// ---------- Phase 2: projects and tasks ----------

model Project {
  id             String    @id @default(cuid())
  organizationId String
  number         String
  name           String
  clientId       String?
  managerId      String
  status         String    @default("ACTIVE") // ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  priority       String    @default("MEDIUM")
  startDate      DateTime?
  deadline       DateTime?
  budgetAmount   Decimal?  @db.Decimal(14, 2)
  currency       String    @default("USD")
  scope          String?
  campaignId     String? // the campaign this project delivers, if any
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  campaign    Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  members     ProjectMember[]
  tasks       Task[]
  milestones  Milestone[]
  timeEntries TimeEntry[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model ProjectMember {
  projectId  String
  userId     String
  role       String? // e.g. Graphic Designer
  hourlyCost Decimal? @db.Decimal(10, 2) // internal cost per hour in the project currency; restricted
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id             String    @id @default(cuid())
  projectId      String
  title          String
  description    String?
  status         String    @default("TODO") // TODO | IN_PROGRESS | REVIEW | DONE
  priority       String    @default("MEDIUM")
  assigneeId     String?
  dueDate        DateTime?
  estimatedHours Decimal?  @db.Decimal(8, 2)
  clientVisible  Boolean   @default(false)
  milestoneId    String?
  blocked        Boolean   @default(false)
  completedAt    DateTime?
  createdById    String?
  parentId       String? // a subtask points at its parent task (one level only)
  blockedBy      String[]  @default([]) // ids of tasks in the same project that must be Done first
  recurrence     String? // DAILY | WEEKLY | MONTHLY: completing the task creates the next one
  recurredFromId String?   @unique // the completed task that created this one, so it is created once
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  comments  TaskComment[]

  @@index([parentId])
  @@index([projectId, status])
  @@index([assigneeId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  internal  Boolean  @default(true) // internal comments are never shown to clients
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ClientInvite {
  id          String    @id @default(cuid())
  clientId    String?
  vendorId    String?
  email       String
  tokenHash   String    @unique // only the hash is stored; the link is shown once
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  client Client? @relation(fields: [clientId], references: [id])
  vendor Vendor? @relation(fields: [vendorId], references: [id])

  @@index([clientId])
}

// ---------- Phase 4: HR ----------

model EmployeeProfile {
  id               String    @id @default(cuid())
  organizationId   String
  userId           String    @unique
  employeeNo       String
  designation      String?
  departmentId     String?
  employmentType   String    @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | INTERN
  workLocation     String    @default("OFFICE") // OFFICE | REMOTE | HYBRID | FIELD
  joinDate         DateTime?
  probationEnd     DateTime?
  phone            String?
  personalEmail    String?
  address          String?
  emergencyContact String?
  // Sensitive: only users with hr.view_sensitive may read these
  dateOfBirth      String? // YYYY-MM-DD
  gender           String?
  fatherName       String?
  identityNumber   String?
  bankDetails      String?
  status           String    @default("ACTIVE") // ACTIVE | INACTIVE | EXITED
  exitDate         DateTime?
  notes            String? // internal HR notes, visible to hr.view
  archivedAt       DateTime? // archived records leave the directory but keep all history

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, employeeNo])
}

model AttendanceRecord {
  id            String    @id @default(cuid())
  userId        String
  workDate      String // YYYY-MM-DD in the company timezone
  clockIn       DateTime
  clockOut      DateTime?
  workMode      String    @default("OFFICE") // OFFICE | REMOTE
  note          String?
  correctedById String?

  breaks BreakRecord[]

  @@unique([userId, workDate])
  @@index([workDate])
}

model BreakRecord {
  id           String    @id @default(cuid())
  attendanceId String
  startAt      DateTime
  endAt        DateTime?

  attendance AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model LeaveType {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  daysPerYear    Decimal @db.Decimal(5, 1)
  paid           Boolean @default(true)
  active         Boolean @default(true)

  requests LeaveRequest[]

  @@unique([organizationId, name])
}

model LeaveRequest {
  id           String    @id @default(cuid())
  userId       String
  leaveTypeId  String
  startDate    String // YYYY-MM-DD
  endDate      String // YYYY-MM-DD
  days         Decimal   @db.Decimal(5, 1) // working days, weekends excluded
  reason       String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  approverId   String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([userId, status])
}

// ---------- Phase 4: payroll ----------

model SalaryStructure {
  id            String   @id @default(cuid())
  userId        String
  effectiveFrom String // YYYY-MM-DD
  currency      String
  basic         Decimal  @db.Decimal(14, 2)
  allowance     Decimal  @default(0) @db.Decimal(14, 2)
  taxPercent    Decimal  @default(0) @db.Decimal(5, 2) // flat withholding; replace with jurisdiction rules later
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([userId, effectiveFrom])
  @@index([userId])
}

model PayrollRun {
  id             String    @id @default(cuid())
  organizationId String
  period         String // YYYY-MM
  currency       String
  status         String    @default("DRAFT") // DRAFT | APPROVED | POSTED | PAID
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  postedAt       DateTime?
  paidAt         DateTime?
  journalEntryId String?
  paymentEntryId String?
  createdAt      DateTime  @default(now())

  items PayrollItem[]

  @@unique([organizationId, period, currency])
}

model PayrollItem {
  id              String  @id @default(cuid())
  runId           String
  userId          String
  workingDays     Int
  unpaidDays      Decimal @db.Decimal(5, 1)
  basic           Decimal @db.Decimal(14, 2)
  allowance       Decimal @db.Decimal(14, 2)
  bonus           Decimal @default(0) @db.Decimal(14, 2)
  commission      Decimal @default(0) @db.Decimal(14, 2) // approved commissions and bonuses paid through this run (already expensed when approved)
  commissionTax   Decimal @default(0) @db.Decimal(14, 2) // tax withheld on that part; included in `tax`
  unpaidDeduction Decimal @db.Decimal(14, 2)
  gross           Decimal @db.Decimal(14, 2)
  taxPercent      Decimal @db.Decimal(5, 2)
  tax             Decimal @db.Decimal(14, 2)
  net             Decimal @db.Decimal(14, 2)

  run PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
}

// ---------- Phase 3: expenses and budgets ----------

model Budget {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  scope          String   @default("COMPANY") // COMPANY | DEPARTMENT | PROJECT
  projectId      String?
  departmentId   String?
  periodStart    String // YYYY-MM-DD
  periodEnd      String
  currency       String
  originalAmount Decimal  @db.Decimal(14, 2) // never overwritten; transfers are tracked separately
  createdById    String?
  createdAt      DateTime @default(now())

  vouchers     ExpenseVoucher[]
  transfersOut BudgetTransfer[] @relation("from")
  transfersIn  BudgetTransfer[] @relation("to")

  @@index([organizationId])
}

model BudgetTransfer {
  id            String    @id @default(cuid())
  fromBudgetId  String
  toBudgetId    String
  amount        Decimal   @db.Decimal(14, 2)
  reason        String
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  from Budget @relation("from", fields: [fromBudgetId], references: [id])
  to   Budget @relation("to", fields: [toBudgetId], references: [id])
}

model ExpenseVoucher {
  id               String   @id @default(cuid())
  organizationId   String
  number           String
  date             String // YYYY-MM-DD
  payee            String
  description      String
  justification    String?
  expenseAccountId String
  projectId        String?
  budgetId         String?
  currency         String
  amount           Decimal  @db.Decimal(14, 2)
  status           String   @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | POSTED | PAID | REJECTED | CANCELLED
  submittedById    String
  reviewedById     String?
  approvedById     String?
  decisionNote     String?
  overBudgetReason String?
  journalEntryId   String?
  paymentEntryId   String?
  paidById         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  budget Budget? @relation(fields: [budgetId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([submittedById])
}

// ---------- Phase 5: vendors and procurement ----------

model Vendor {
  id               String   @id @default(cuid())
  organizationId   String
  code             String
  name             String
  email            String?
  phone            String?
  country          String?
  currency         String   @default("USD")
  categories       String? // comma separated service categories
  paymentTermsDays Int      @default(30)
  status           String   @default("PENDING") // PENDING | APPROVED | SUSPENDED
  bankDetails      String? // restricted
  internalNotes    String?
  createdAt        DateTime @default(now())

  applications VendorApplication[]
  workOrders   WorkOrder[]
  bills        VendorBill[]
  invites      ClientInvite[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
}

model VendorOpportunity {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  scope          String
  skills         String?
  budgetMin      Decimal? @db.Decimal(14, 2)
  budgetMax      Decimal? @db.Decimal(14, 2)
  currency       String   @default("USD")
  deadline       String? // YYYY-MM-DD application deadline
  status         String   @default("OPEN") // OPEN | CLOSED | AWARDED
  createdById    String?
  createdAt      DateTime @default(now())

  applications VendorApplication[]
}

model VendorApplication {
  id            String   @id @default(cuid())
  opportunityId String
  vendorId      String
  quoteAmount   Decimal  @db.Decimal(14, 2)
  proposal      String?
  status        String   @default("SUBMITTED") // SUBMITTED | SHORTLISTED | APPROVED | REJECTED
  decidedById   String?
  createdAt     DateTime @default(now())

  opportunity VendorOpportunity @relation(fields: [opportunityId], references: [id])
  vendor      Vendor            @relation(fields: [vendorId], references: [id])

  @@unique([opportunityId, vendorId])
}

model WorkOrder {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  vendorId       String
  applicationId  String?  @unique
  projectId      String?
  title          String
  scope          String?
  amount         Decimal  @db.Decimal(14, 2)
  currency       String
  status         String   @default("ISSUED") // ISSUED | DELIVERED | ACCEPTED | CANCELLED
  issuedById     String?
  acceptedById   String?
  createdAt      DateTime @default(now())

  vendor Vendor       @relation(fields: [vendorId], references: [id])
  bills  VendorBill[]

  @@unique([organizationId, number])
}

model VendorBill {
  id               String   @id @default(cuid())
  organizationId   String
  number           String
  vendorId         String
  workOrderId      String
  vendorReference  String?
  amount           Decimal  @db.Decimal(14, 2)
  currency         String
  expenseAccountId String?
  status           String   @default("SUBMITTED") // SUBMITTED | APPROVED | POSTED | PAID | REJECTED
  approvedById     String?
  decisionNote     String?
  journalEntryId   String?
  paymentEntryId   String?
  createdAt        DateTime @default(now())

  vendor    Vendor    @relation(fields: [vendorId], references: [id])
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])

  @@unique([organizationId, number])
  @@index([vendorId])
}

// ---------- Phase 5: fixed assets and investments ----------

model Asset {
  id               String   @id @default(cuid())
  organizationId   String
  number           String
  name             String
  category         String?
  serialNumber     String?
  supplier         String?
  purchaseDate     String // YYYY-MM-DD
  cost             Decimal  @db.Decimal(14, 2)
  salvageValue     Decimal  @default(0) @db.Decimal(14, 2)
  currency         String
  usefulLifeMonths Int
  location         String?
  status           String   @default("ACTIVE") // ACTIVE | DISPOSED
  assignedToId     String?
  purchaseEntryId  String?
  disposedDate     String?
  disposalProceeds Decimal? @db.Decimal(14, 2)
  disposalEntryId  String?
  createdAt        DateTime @default(now())

  depreciation DepreciationEntry[]
  assignments  AssetAssignment[]

  @@unique([organizationId, number])
}

model DepreciationEntry {
  id             String  @id @default(cuid())
  assetId        String
  period         String // YYYY-MM
  amount         Decimal @db.Decimal(14, 2)
  journalEntryId String?

  asset Asset @relation(fields: [assetId], references: [id])

  @@unique([assetId, period])
}

model AssetAssignment {
  id         String    @id @default(cuid())
  assetId    String
  userId     String
  assignedAt DateTime  @default(now())
  returnedAt DateTime?

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([assetId])
}

model Investment {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  name           String
  category       String?
  investee       String
  currency       String
  investmentDate String
  ownershipPct   Decimal? @db.Decimal(5, 2)
  expectedReturn String?
  status         String   @default("ACTIVE") // ACTIVE | EXITED
  createdAt      DateTime @default(now())

  transactions InvestmentTransaction[]

  @@unique([organizationId, number])
}

model InvestmentTransaction {
  id             String   @id @default(cuid())
  investmentId   String
  kind           String // CAPITAL | INCOME_RECOGNISED | INCOME_RECEIVED
  amount         Decimal  @db.Decimal(14, 2)
  date           String
  note           String?
  journalEntryId String?
  createdById    String?
  createdAt      DateTime @default(now())

  investment Investment @relation(fields: [investmentId], references: [id])

  @@index([investmentId])
}

// ---------- Notifications, content calendar, prospecting worklists ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String?
  link      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model ContentItem {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String? // empty for the company's own posts, which are approved internally
  projectId      String?
  platform       String // FACEBOOK | INSTAGRAM | TIKTOK | LINKEDIN | YOUTUBE | OTHER
  title          String
  copy           String
  hashtags       String?
  plannedDate    String? // YYYY-MM-DD
  plannedTime    String? // HH:MM, local time of the company
  postType       String   @default("STATIC") // STORY | REEL | STATIC | CAROUSEL | VIDEO | LIVE
  platforms      String[] @default([]) // every platform it goes to; platform above is the first one
  status         String   @default("DRAFT") // DRAFT | INTERNAL_REVIEW | CLIENT_REVIEW | CHANGES_REQUESTED | APPROVED | SCHEDULED | PUBLISHED
  version        Int      @default(1)
  assignedToId   String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  events   ContentEvent[]
  versions ContentVersion[]

  @@index([organizationId, status])
  @@index([clientId, status])
}

model ContentVersion {
  id        String   @id @default(cuid())
  itemId    String
  version   Int
  copy      String
  hashtags  String?
  createdAt DateTime @default(now())

  item ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, version])
}

model ContentEvent {
  id         String   @id @default(cuid())
  itemId     String
  actorId    String
  actorType  String // STAFF | CLIENT
  fromStatus String?
  toStatus   String
  comment    String?
  createdAt  DateTime @default(now())

  item ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model SuppressedContact {
  id             String   @id @default(cuid())
  organizationId String
  email          String?
  phone          String?
  reason         String?
  createdAt      DateTime @default(now())

  @@index([organizationId, email])
  @@index([organizationId, phone])
}

model Worklist {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  source         String?
  assignedToId   String?
  targetDate     String?
  createdById    String
  createdAt      DateTime @default(now())

  rows WorklistRow[]
}

model WorklistRow {
  id              String   @id @default(cuid())
  worklistId      String
  rowNumber       Int // original row in the source file
  name            String
  company         String?
  email           String?
  phone           String?
  raw             Json
  status          String   @default("NEW") // NEW | CONTACTED | NOT_INTERESTED | DO_NOT_CONTACT | CONVERTED
  note            String?
  duplicateLeadId String?
  convertedLeadId String?
  updatedAt       DateTime @updatedAt

  worklist Worklist @relation(fields: [worklistId], references: [id], onDelete: Cascade)

  @@index([worklistId, status])
}

// ---------- Accountant essentials ----------

model PeriodLock {
  organizationId String   @id
  lockedThrough  String // YYYY-MM-DD: nothing may be posted on or before this date
  lockedById     String?
  updatedAt      DateTime @updatedAt
}

model ManualJournal {
  id             String   @id @default(cuid())
  organizationId String
  date           String // YYYY-MM-DD
  memo           String
  currency       String
  lines          Json // [{ accountId, debit, credit, memo }]
  status         String   @default("PENDING") // PENDING | POSTED | REJECTED
  createdById    String
  decidedById    String?
  decisionNote   String?
  journalEntryId String?
  createdAt      DateTime @default(now())

  @@index([organizationId, status])
}

model CreditNote {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  invoiceId      String
  clientId       String
  amount         Decimal  @db.Decimal(14, 2)
  taxPortion     Decimal  @db.Decimal(14, 2)
  currency       String
  reason         String
  kind           String   @default("CREDIT") // CREDIT | WRITE_OFF
  idempotencyKey String   @unique
  journalEntryId String?
  createdById    String
  createdAt      DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([organizationId, number])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// ---------- File storage and document settings ----------

model StoredFile {
  id             String    @id @default(cuid())
  organizationId String
  ownerType      String // EXPENSE | VENDOR_BILL | CONTENT | EMPLOYEE
  ownerId        String
  filename       String // display name only; never used as a path
  contentType    String // decided by the server from the file contents, not by the uploader
  size           Int
  sha256         String
  storageKey     String    @unique // random; where the bytes live in the storage provider
  category       String?
  expiresOn      String? // YYYY-MM-DD, for documents that lapse (employee IDs, contracts)
  scanStatus     String    @default("UNSCANNED") // UNSCANNED | CLEAN | INFECTED
  uploadedById   String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  deletedById    String?

  @@index([organizationId, ownerType, ownerId])
}

model DocumentSetting {
  id             String   @id @default(cuid())
  organizationId String
  docType        String // INVOICE | RECEIPT | CREDIT_NOTE | STATEMENT | PAYSLIP | VOUCHER
  config         Json
  version        Int      @default(1)
  updatedById    String?
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, docType])
}

// Rate meaning: 1 unit of `currency` = `rate` units of the organization's base currency, valid from `effectiveDate`.
// Rows are never edited; a correction is a new row for the same date (the latest entry wins) so history stays traceable.
model ExchangeRate {
  id             String   @id @default(cuid())
  organizationId String
  currency       String
  rate           Decimal  @db.Decimal(18, 8)
  effectiveDate  String // YYYY-MM-DD
  source         String   @default("MANUAL")
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([organizationId, currency, effectiveDate])
}

// ---------- Quotations, subscriptions, contracts ----------

model Quote {
  id             String    @id @default(cuid())
  organizationId String
  number         String
  clientId       String
  status         String    @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED | EXPIRED | INVOICED | CANCELLED
  currency       String
  validUntil     String? // YYYY-MM-DD
  subtotal       Decimal   @default(0) @db.Decimal(14, 2)
  taxRate        Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(14, 2)
  total          Decimal   @default(0) @db.Decimal(14, 2)
  notes          String?
  terms          String?
  sentAt         DateTime?
  decidedAt      DateTime?
  decidedById    String?
  decidedVia     String? // PORTAL | STAFF
  decisionNote   String?
  invoiceId      String?   @unique
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client Client      @relation(fields: [clientId], references: [id])
  lines  QuoteLine[]

  @@unique([organizationId, number])
  @@index([organizationId, clientId, status])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)
  planId      String? // set when the line came from a catalog plan
  planVersion Int? // the plan version whose price was used

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

// A recurring charge. Each due period creates one draft invoice for a person to review and issue.
model Subscription {
  id              String   @id @default(cuid())
  organizationId  String
  clientId        String
  name            String
  currency        String
  amount          Decimal  @db.Decimal(14, 2) // per billing period, before tax
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  interval        String   @default("MONTHLY") // MONTHLY | QUARTERLY | ANNUAL
  startDate       String // YYYY-MM-DD
  endDate         String?
  nextBillingDate String? // null once the subscription has run its course
  cyclesBilled    Int      @default(0)
  status          String   @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED | ENDED
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client   Client                @relation(fields: [clientId], references: [id])
  invoices SubscriptionInvoice[]

  @@index([organizationId, status, nextBillingDate])
}

model SubscriptionInvoice {
  id             String   @id @default(cuid())
  subscriptionId String
  periodStart    String
  invoiceId      String   @unique
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, periodStart])
}

model Contract {
  id                String   @id @default(cuid())
  organizationId    String
  clientId          String
  title             String
  status            String   @default("DRAFT") // DRAFT | ACTIVE | EXPIRED | TERMINATED
  startDate         String?
  endDate           String?
  renewalNoticeDays Int      @default(30)
  currency          String?
  value             Decimal? @db.Decimal(14, 2)
  notes             String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])

  @@index([organizationId, status, endDate])
}

// ---------- Project depth: milestones, time, profitability ----------

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  dueDate     String? // YYYY-MM-DD
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | DONE
  amount      Decimal?  @db.Decimal(14, 2) // what is billed to the client when this milestone is done
  invoiceId   String?   @unique
  sortOrder   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, sortOrder])
}

model TimeEntry {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  taskId         String?
  userId         String
  workDate       String // YYYY-MM-DD
  hours          Decimal   @db.Decimal(5, 2)
  note           String?
  hourlyCost     Decimal?  @db.Decimal(10, 2) // the member's cost rate when the time was logged, so later rate changes never rewrite history
  approval       String    @default("PENDING") // PENDING | APPROVED | REJECTED (informational: profitability counts all entries)
  approvedById   String?
  approvedAt     DateTime?
  approvalNote   String?
  createdAt      DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, workDate])
  @@index([organizationId, approval])
  @@index([userId, workDate])
}

// ---------- Bank reconciliation and year-end close ----------

model BankStatementLine {
  id             String   @id @default(cuid())
  organizationId String
  bankAccountId  String
  date           String // YYYY-MM-DD
  description    String
  reference      String?
  amount         Decimal  @db.Decimal(14, 2) // positive = money in, negative = money out
  dedupKey       String // the same line imported twice is recognised and skipped
  importedById   String?
  createdAt      DateTime @default(now())

  @@unique([bankAccountId, dedupKey])
  @@index([organizationId, bankAccountId, date])
}

// Links one bank statement line to one ledger line (or clears a ledger line as part of the opening position).
model BankMatch {
  id               String   @id @default(cuid())
  organizationId   String
  bankAccountId    String
  statementLineId  String?  @unique
  journalLineId    String   @unique
  kind             String   @default("STATEMENT") // STATEMENT | OPENING
  matchedById      String?
  reconciliationId String?
  createdAt        DateTime @default(now())

  @@index([bankAccountId])
}

model BankReconciliation {
  id                 String   @id @default(cuid())
  organizationId     String
  bankAccountId      String
  statementDate      String
  statementBalance   Decimal  @db.Decimal(14, 2)
  ledgerBalance      Decimal  @db.Decimal(14, 2)
  outstandingLedger  Decimal  @db.Decimal(14, 2) // ledger lines not on the statement (signed)
  unmatchedStatement Decimal  @db.Decimal(14, 2) // statement lines not in the ledger (signed)
  difference         Decimal  @db.Decimal(14, 2)
  completedById      String?
  createdAt          DateTime @default(now())

  @@index([organizationId, bankAccountId, statementDate])
}

// Named tax rates offered when writing invoices, quotations and subscriptions. An invoice still stores the percentage it was issued with.
model TaxRate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  ratePercent    Decimal  @db.Decimal(5, 2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([organizationId, name])
}

// Every email the system tries to send. The status is only SENT when the mail server accepted the message;
// with no mail account configured the status is NOT_CONFIGURED and nothing is claimed as delivered.
model EmailMessage {
  id                String    @id @default(cuid())
  organizationId    String
  toEmail           String
  subject           String
  body              String
  attachmentName    String?
  relatedType       String? // INVOICE | QUOTE | STATEMENT | TEST
  relatedId         String?
  status            String // SENT | FAILED | NOT_CONFIGURED
  error             String?
  providerMessageId String?
  createdById       String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  @@index([organizationId, createdAt])
  @@index([relatedType, relatedId])
}

// ---------- Commissions and incentives ----------

// A salesperson earns this percentage of the revenue (before tax) from clients they converted, as payments arrive.
model CommissionRule {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  ratePercent    Decimal  @db.Decimal(5, 2)
  active         Boolean  @default(true)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
}

model CommissionEntry {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  kind           String    @default("COMMISSION") // COMMISSION | BONUS
  allocationId   String? // the payment allocation that earned it; with role it is unique, so one payment is never commissioned twice for the same role
  role           String    @default("SALES_AGENT") // SALES_AGENT | SALES_MANAGER: whose share of the allocation this is
  campaignId     String? // the campaign whose rate was used, when one applied
  invoiceId      String?
  clientId       String?
  currency       String
  base           Decimal   @default(0) @db.Decimal(14, 2) // revenue the percentage was applied to
  ratePercent    Decimal   @default(0) @db.Decimal(5, 2)
  amount         Decimal   @db.Decimal(14, 2)
  note           String?
  status         String    @default("EARNED") // EARNED | APPROVED | PAID | VOID
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  accrualEntryId String?
  paidById       String?
  paidAt         DateTime?
  paymentEntryId String?
  payrollRunId   String? // set while the entry is being paid through a payroll run
  createdAt      DateTime  @default(now())

  @@unique([allocationId, role])
  @@index([organizationId, status])
  @@index([userId, createdAt])
  @@index([payrollRunId])
}

// What people asked the assistant and which data it read, for audit. Answers are not stored: they are rebuilt from live data when asked again.
model AssistantLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  question       String
  toolsUsed      String[]
  status         String // ANSWERED | FAILED | NOT_CONFIGURED
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// ---------- CRM depth: campaigns, smart lists, sales targets ----------

model Campaign {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  channel        String    @default("OTHER") // FACEBOOK | INSTAGRAM | LINKEDIN | GOOGLE | EMAIL | REFERRAL | COLD_CALLING | EVENT | OTHER
  status         String    @default("ACTIVE") // PLANNED | ACTIVE | PAUSED | DONE
  budget         Decimal?  @db.Decimal(14, 2)
  currency       String    @default("USD")
  startDate      String?
  endDate        String?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  code           String? // CMP-0001, from NumberSequence "CAMPAIGN"
  categoryId     String? // the shared business category list (ServiceCategory)
  description    String?
  objectives     String?
  ownerId        String?
  archivedAt     DateTime?
  updatedAt      DateTime? @updatedAt

  category ServiceCategory? @relation(fields: [categoryId], references: [id])
  members  CampaignMember[]
  clients  CampaignClient[]
  projects Project[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId, categoryId])
}

// Staff assigned to a campaign (their workload). One row per person per campaign.
model CampaignMember {
  campaignId String
  userId     String
  role       String?
  addedAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([userId])
}

// Client accounts a campaign is run for. Links to the canonical Client record.
model CampaignClient {
  campaignId String
  clientId   String
  addedAt    DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([campaignId, clientId])
  @@index([clientId])
}

// Saved filters over leads. Private to the owner unless shared with everyone who can open the Leads screen.
model SmartList {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String
  name           String
  filters        Json
  shared         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([organizationId, ownerId, name])
}

// Daily and monthly goals per person and activity type, for example 80 connected calls a day.
model SalesTarget {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  metric         String // CALLS | CONNECTED_CALLS | EMAILS | MEETINGS | FOLLOW_UPS | PROPOSALS | CONVERSIONS
  daily          Int?
  monthly        Int?
  updatedById    String?
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId, metric])
}

// ---------- Work activity monitoring (transparent, consent-based; see docs/MONITORING.md) ----------

// Off until an administrator turns it on. Changing what is collected raises the version, and everyone must read and accept the new version before anything is recorded about them.
model MonitoringPolicy {
  organizationId        String   @id
  version               Int      @default(1)
  enabled               Boolean  @default(false)
  policyText            String   @default("")
  trackActivity         Boolean  @default(true) // aggregate active/idle time and key and click COUNTS (never what was typed)
  trackApps             Boolean  @default(false) // names of applications used, as durations
  screenshots           Boolean  @default(false)
  screenshotIntervalMin Int      @default(10)
  idleThresholdMin      Int      @default(5)
  timezone              String   @default("Asia/Karachi") // working hours below are in this time zone
  workStart             String   @default("09:00")
  workEnd               String   @default("18:00")
  workDays              String   @default("1,2,3,4,5") // 0 = Sunday
  retentionDays         Int      @default(30)
  updatedById           String?
  updatedAt             DateTime @updatedAt
}

model PolicyAck {
  id        String   @id @default(cuid())
  userId    String
  version   Int
  createdAt DateTime @default(now())

  @@unique([userId, version])
}

model WorkSession {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  lastBeatAt     DateTime  @default(now())
  source         String    @default("WEB") // WEB | AGENT
  projectId      String?
  taskId         String?
  note           String?

  breaks WorkBreak[]

  @@index([userId, startedAt])
  @@index([organizationId, startedAt])
}

model WorkBreak {
  id        String    @id @default(cuid())
  sessionId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  session WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// Totals for a five-minute window. Counts only: no content, no key names, no pointer positions.
model ActivityBucket {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  bucketStart    DateTime
  activeSeconds  Int      @default(0)
  idleSeconds    Int      @default(0)
  keyCount       Int      @default(0)
  clickCount     Int      @default(0)
  source         String   @default("WEB")

  @@unique([userId, bucketStart, source])
  @@index([organizationId, bucketStart])
}

model AppUsage {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  day            String // YYYY-MM-DD
  name           String // application name only, never window titles or addresses
  seconds        Int    @default(0)

  @@unique([userId, day, name])
  @@index([organizationId, day])
}

model AppCategory {
  id             String @id @default(cuid())
  organizationId String
  pattern        String // matched against the application name, case-insensitive
  category       String // PRODUCTIVE | NEUTRAL | UNPRODUCTIVE

  @@unique([organizationId, pattern])
}

model MonitorDevice {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  name           String
  os             String?
  agentVersion   String?
  tokenHash      String    @unique
  enrolledAt     DateTime  @default(now())
  lastSeenAt     DateTime?
  revokedAt      DateTime?

  @@index([userId])
}

model EnrollmentCode {
  id          String    @id @default(cuid())
  userId      String
  codeHash    String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
}

model Screenshot {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  deviceId       String?
  capturedAt     DateTime
  storageKey     String    @unique
  contentType    String
  size           Int
  sha256         String
  disputed       Boolean   @default(false)
  disputeNote    String?
  deletedAt      DateTime?

  @@index([userId, capturedAt])
  @@index([organizationId, capturedAt])
}

// Every time someone other than the employee opens a screenshot or a detailed report, so employees can see who looked.
model MonitoringAccess {
  id             String   @id @default(cuid())
  organizationId String
  viewerId       String
  subjectId      String
  what           String // SCREENSHOT | REPORT
  targetId       String?
  createdAt      DateTime @default(now())

  @@index([subjectId, createdAt])
}

model TimesheetCorrection {
  id               String    @id @default(cuid())
  organizationId   String
  userId           String
  day              String // YYYY-MM-DD
  requestedMinutes Int // tracked minutes the employee says the day should show
  reason           String
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  createdAt        DateTime  @default(now())

  @@index([organizationId, status])
  @@index([userId, day])
}

// ---------- Meetings and online workshops (video, screen share, chat) ----------

model Meeting {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  kind           String    @default("MEETING") // MEETING | WORKSHOP
  hostId         String
  projectId      String?
  clientId       String?
  contactId      String?
  agenda         String?
  scheduledAt    DateTime?
  durationMin    Int       @default(60)
  joinToken      String    @unique // the secret in the guest link
  waitingRoom    Boolean   @default(true)
  status         String    @default("SCHEDULED") // SCHEDULED | LIVE | ENDED | CANCELLED
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())

  participants MeetingParticipant[]
  messages     MeetingMessage[]

  @@index([organizationId, scheduledAt])
  @@index([projectId])
}

model MeetingParticipant {
  id         String    @id @default(cuid())
  meetingId  String
  userId     String? // set for staff; guests have only a name
  name       String
  isHost     Boolean   @default(false)
  ticket     String    @unique // proves this browser is this participant
  status     String    @default("WAITING") // WAITING | ADMITTED | DENIED | LEFT | REMOVED
  joinedAt   DateTime  @default(now())
  admittedAt DateTime?
  leftAt     DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, status])
}

model MeetingMessage {
  id            String   @id @default(cuid())
  meetingId     String
  participantId String
  authorName    String
  body          String
  createdAt     DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
}

// ---------- Contacts and organizations: the one record every board points to ----------

// A person or an organization. Leads, clients, quotes, meetings and activities hang off it, so a change made here shows everywhere.
model Contact {
  id               String    @id @default(cuid())
  organizationId   String
  kind             String    @default("PERSON") // PERSON | ORGANIZATION
  title            String?
  firstName        String?
  lastName         String?
  name             String // display name: "First Last" for a person, the company name for an organization
  parentId         String? // the organization a person works for
  category         String    @default("LEAD") // LEAD | CUSTOMER | PARTNER | VENDOR | INVESTOR | OTHER
  industry         String?
  jobTitle         String?
  ownerId          String?
  followers        String[]  @default([])
  website          String?
  phones           Json      @default("[]") // [{ type: "WORK|MOBILE|HOME|WHATSAPP|OTHER", value }]
  emails           Json      @default("[]") // [{ type: "WORK|PERSONAL|BILLING|OTHER", value }]
  matchKeys        String[]  @default([]) // every email and normalised phone, for duplicate detection
  primaryPhone     String? // normalised copies of the first entry, for matching and sorting
  primaryEmail     String?
  addressLine      String?
  city             String?
  state            String?
  country          String?
  postalCode       String?
  timezone         String?
  preferredContact String?
  source           String?
  campaignId       String?
  tags             String[]  @default([])
  notes            String?
  customFields     Json      @default("{}")
  birthday         String? // YYYY-MM-DD
  taxId            String?
  shipAddressLine  String?
  shipCity         String?
  shipState        String?
  shipCountry      String?
  shipPostalCode   String?
  social           Json      @default("{}") // facebook, linkedin, telegram, x, skype, instagram
  utm              Json      @default("{}") // source, medium, campaign, term, content
  archived         Boolean   @default(false)
  lastActivityAt   DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  activities ContactActivity[]

  @@index([organizationId, kind, archived])
  @@index([organizationId, primaryEmail])
  @@index([organizationId, primaryPhone])
  @@index([parentId])
  @@index([matchKeys], type: Gin)
}

model ContactActivity {
  id             String   @id @default(cuid())
  contactId      String
  actorId        String?
  kind           String // NOTE | CALL | EMAIL | MEETING | WHATSAPP | SYSTEM
  outcome        String?
  body           String?
  leadActivityId String?  @unique // set when the same event also exists on a linked lead, so it is shown once and counted once
  createdAt      DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([actorId, createdAt])
}

// ---------- Personal preferences ----------

// Small per-user settings such as the dashboard layout. One row per user and key.
model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// ---------- Scheduled jobs ----------
model JobRun {
  id             String    @id @default(cuid())
  organizationId String
  key            String // subscription_billing | commission_accrual | expiry_sweep | invoice_reminders | task_reminders | monitoring_purge | document_expiry
  trigger        String    @default("SCHEDULE") // SCHEDULE | MANUAL | SCRIPT
  runDate        String // company-local day, so a job runs once a day
  status         String    @default("RUNNING") // RUNNING | OK | FAILED
  summary        String?
  error          String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  startedById    String?

  @@index([organizationId, key, startedAt])
}

// ---------- Client support ----------
model SupportRequest {
  id             String    @id @default(cuid())
  organizationId String
  number         String // SUP-0001
  clientId       String
  createdById    String // the portal user who raised it (or staff on their behalf)
  subject        String
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | WAITING_CLIENT | RESOLVED | CLOSED
  priority       String    @default("NORMAL") // NORMAL | HIGH | URGENT
  assigneeId     String?
  projectId      String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages SupportMessage[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([clientId, status])
  @@index([assigneeId])
}

model SupportMessage {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  body      String
  internal  Boolean  @default(false) // internal notes are never shown to the client
  createdAt DateTime @default(now())

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// ---------- Deliverables and client approval ----------
model Deliverable {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  campaignId     String?
  title          String
  description    String?
  link           String? // where the client can see the proof (design, document, staging site)
  status         String    @default("DRAFT") // DRAFT | PENDING | APPROVED | CHANGES_REQUESTED
  version        Int       @default(1)
  requestedAt    DateTime?
  requestedById  String?
  decidedAt      DateTime?
  decidedById    String? // the portal user who decided
  decisionNote   String?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([projectId, status])
  @@index([organizationId, status])
  @@index([campaignId])
}

// ---------- Lead capture ----------
model LeadSource {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String    @unique // only the hash of the public key is stored; the key is shown once
  campaignId     String?
  assignMode     String    @default("ROUND_ROBIN") // NONE | FIXED | ROUND_ROBIN
  assigneeIds    String[]  @default([])
  rrIndex        Int       @default(0)
  allowedOrigins String? // comma separated; empty means any website may post with the key
  active         Boolean   @default(true)
  leadCount      Int       @default(0)
  lastLeadAt     DateTime?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, name])
}

// ---------- Campaign spend ----------
model CampaignSpend {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String
  date           String // YYYY-MM-DD
  platform       String // free text such as Meta, Google, TikTok, Print
  amount         Decimal  @db.Decimal(14, 2)
  currency       String
  impressions    Int?
  clicks         Int?
  results        Int?
  note           String?
  enteredById    String
  createdAt      DateTime @default(now())

  @@index([campaignId, date])
  @@index([organizationId, date])
}

// ---------- Agreements and e-signature ----------
model DocumentTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  kind           String   @default("CONTRACT") // CONTRACT | PROPOSAL | NDA | OTHER
  body           String // text with {{placeholders}}
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, name])
}

model Agreement {
  id              String    @id @default(cuid())
  organizationId  String
  number          String // AGR-0001
  title           String
  body            String // the final text the signer sees
  bodyHash        String // sha256 of the text at the moment it was sent; the signature is bound to it
  clientId        String?
  vendorId        String?
  templateId      String?
  status          String    @default("DRAFT") // DRAFT | SENT | SIGNED | DECLINED | VOID
  tokenHash       String?   @unique
  tokenExpiresAt  DateTime?
  signerName      String?
  signerEmail     String?
  signedAt        DateTime?
  signedIp        String?
  signedUserAgent String?
  signatureImage  String? // small PNG data URL drawn by the signer (optional)
  declineReason   String?
  sentAt          DateTime?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

// ---------- Job applications (from the careers pages of the public website) ----------
// The roles themselves are listed on the website (src/app/(site)/_content/jobs.ts); an application keeps the role's id and
// title as they were when the person applied. The CV is a StoredFile with ownerType JOB_APPLICATION (cvFileId).
model JobApplication {
  id             String    @id @default(cuid())
  organizationId String
  jobId          Int
  jobTitle       String
  name           String
  email          String
  phone          String
  profileUrl     String?
  coverNote      String?
  cvFileId       String?
  status         String    @default("NEW") // NEW | REVIEWING | SHORTLISTED | INTERVIEW | OFFERED | HIRED | REJECTED
  notes          String? // HR's own notes, never shown to the applicant
  submissions    Int       @default(1) // the same person applying again for the same role updates this record
  sourceUrl      String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, jobId, email])
  @@index([organizationId, status, createdAt])
}

// ---------- Mailboxes (company email, sent through Resend or SMTP, received through a Resend webhook) ----------

// One address on the company domain. SYSTEM mailboxes (noreply, billing, hr, onboarding, finance) carry a purpose so the
// system knows which address sends which kind of message. PERSONAL mailboxes belong to one employee; SHARED ones to a team.
model Mailbox {
  id             String   @id @default(cuid())
  organizationId String
  address        String   @unique // lower case, e.g. billing@hifimarketing.co
  displayName    String
  kind           String // SYSTEM | SHARED | PERSONAL
  purpose        String? // NOREPLY | BILLING | HR | ONBOARDING | FINANCE (SYSTEM only)
  ownerId        String? // PERSONAL: the employee it belongs to
  signature      String?
  active         Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members  MailboxMember[]
  threads  MailThread[]
  messages MailMessage[]

  @@unique([organizationId, purpose])
  @@index([organizationId, kind])
}

// Who may read and send from a mailbox. Every member signs in with their own Hifi One login.
model MailboxMember {
  id        String   @id @default(cuid())
  mailboxId String
  userId    String
  canSend   Boolean  @default(true)
  createdAt DateTime @default(now())

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, userId])
  @@index([userId])
}

// A conversation inside one mailbox. Linked to a client, CRM contact or employee when the other side is known.
model MailThread {
  id             String   @id @default(cuid())
  organizationId String
  mailboxId      String
  subject        String
  counterpart    String // the other side's address (first external participant)
  clientId       String?
  contactId      String?
  employeeId     String? // a User, for HR conversations with staff
  status         String   @default("OPEN") // OPEN | ARCHIVED
  unread         Int      @default(0)
  snippet        String   @default("")
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  mailbox  Mailbox       @relation(fields: [mailboxId], references: [id])
  messages MailMessage[]

  @@index([mailboxId, status, lastMessageAt])
  @@index([organizationId, clientId])
  @@index([organizationId, employeeId])
}

model MailMessage {
  id              String   @id @default(cuid())
  organizationId  String
  mailboxId       String
  threadId        String
  direction       String // IN | OUT
  fromAddress     String
  fromName        String?
  toAddresses     String[]
  ccAddresses     String[] @default([])
  subject         String
  text            String
  html            String? // inbound only; shown sandboxed, never as live markup
  messageId       String? // RFC Message-ID, used for threading replies
  inReplyTo       String?
  references      String[] @default([])
  attachmentNames String[] @default([])
  status          String // SENT | FAILED | NOT_CONFIGURED | RECEIVED
  error           String?
  providerId      String?  @unique // Resend email id (sent or received); makes webhook retries harmless
  sentById        String?
  relatedType     String? // set when the system sent it (INVOICE, QUOTE, STATEMENT, ...)
  relatedId       String?
  createdAt       DateTime @default(now())

  mailbox Mailbox    @relation(fields: [mailboxId], references: [id])
  thread  MailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([mailboxId, messageId])
  @@index([organizationId, createdAt])
}

// ---------- Branded email templates, onboarding approval and follow-up automation ----------

// An edited copy of a built-in template (key = the built-in key) or a follow-up template made in the ERP (kind FOLLOW_UP).
// Built-in templates without a row use the wording in src/lib/email-templates.ts. Variables are written {{like_this}}.
model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  kind           String   @default("SYSTEM") // SYSTEM | FOLLOW_UP
  name           String
  subject        String
  preheader      String?
  heading        String
  body           String
  buttonLabel    String?
  buttonUrl      String? // follow-up templates only; built-in templates link where the system says
  highlights     String? // up to three lines "Title | text", shown as cards
  archived       Boolean  @default(false)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  steps FollowUpStep[]

  @@unique([organizationId, key])
  @@index([organizationId, kind])
}

// A new staff account waits here until its email is verified with a one-time code and an approver accepts it.
// Accounts without a row (everyone created before this existed) are not affected.
model OnboardingRequest {
  id             String    @id @default(cuid())
  organizationId String
  userId         String    @unique
  status         String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | PENDING_APPROVAL | APPROVED | REJECTED
  tokenHash      String?   @unique // the link in the code email; only the hash is kept
  tokenExpiresAt DateTime?
  codeHash       String?
  codeExpiresAt  DateTime?
  codeAttempts   Int       @default(0)
  codesSent      Int       @default(0)
  lastCodeAt     DateTime?
  verifiedAt     DateTime?
  requestedById  String?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, status])
}

// GoHighLevel-style follow-up: a timed series of emails to new CRM leads, stopped by a reply, a stage change or an unsubscribe.
model FollowUpSequence {
  id                String    @id @default(cuid())
  organizationId    String
  name              String
  description       String?
  active            Boolean   @default(false)
  trigger           String    @default("NEW_LEAD") // NEW_LEAD (every new lead with an email) | MANUAL (enrolled from the lead page)
  leadSourceId      String? // only leads from this website form
  tag               String? // only leads with this tag
  stopOnStageChange Boolean   @default(true)
  mailboxId         String? // the address it sends from
  fromOwner         Boolean   @default(true) // use the lead owner's own mailbox when they have one
  activatedAt       DateTime? // new leads created after this moment are enrolled automatically
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  steps       FollowUpStep[]
  enrollments FollowUpEnrollment[]

  @@index([organizationId, active])
}

model FollowUpStep {
  id         String @id @default(cuid())
  sequenceId String
  position   Int // 0, 1, 2 ...
  delayDays  Int // days after enrolment (day 0, 2, 5, 10)
  templateId String

  sequence FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template EmailTemplate    @relation(fields: [templateId], references: [id])

  @@unique([sequenceId, position])
}

model FollowUpEnrollment {
  id             String    @id @default(cuid())
  organizationId String
  sequenceId     String
  leadId         String
  email          String
  status         String    @default("ACTIVE") // ACTIVE | COMPLETED | STOPPED
  stopReason     String? // REPLIED | STAGE_CHANGED | UNSUBSCRIBED | WON | LOST | MANUAL | SEND_FAILED | NO_EMAIL
  nextStep       Int       @default(0)
  nextSendAt     DateTime?
  failures       Int       @default(0)
  stageIdAtStart String
  enrolledById   String?
  enrolledAt     DateTime  @default(now())
  stoppedAt      DateTime?
  stoppedById    String?

  sequence FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  lead     Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sends    FollowUpSend[]

  @@unique([sequenceId, leadId])
  @@index([status, nextSendAt])
  @@index([organizationId, email])
  @@index([leadId])
}

// One row per step sent (or tried). The unique key means a step is never sent twice, even if two runners overlap.
model FollowUpSend {
  id             String   @id @default(cuid())
  enrollmentId   String
  position       Int
  status         String // SENDING | SENT | FAILED
  emailMessageId String?
  subject        String?
  error          String?
  createdAt      DateTime @default(now())

  enrollment FollowUpEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, position])
}

// The commission rate for a campaign or product (for example 3% digital marketing, 5% Agentify ERP subscription), per role.
// Shown to sales staff for motivation and used when a client's payments earn commission. Changing a rate restarts effectiveFrom
// so only later payments use it.
model CampaignCommissionRate {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String
  role           String // SALES_AGENT | SALES_MANAGER
  ratePercent    Decimal  @db.Decimal(5, 2)
  active         Boolean  @default(true)
  effectiveFrom  DateTime @default(now())
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([campaignId, role])
  @@index([organizationId, active])
}
