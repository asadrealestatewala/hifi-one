generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity, organization, access control ----------

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches    Branch[]
  departments Department[]
  users       User[]
  roles       Role[]
  profiles    CompanyProfile[]
  bankAccounts BankAccount[]
  auditLogs   AuditLog[]
  settingChanges SettingChange[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  kind           String   @default("OFFICE") // REGISTERED_OFFICE | SALES_CENTRE | OFFICE
  country        String?
  address        String?
  timezone       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]

  @@unique([organizationId, name])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]

  @@unique([organizationId, name])
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String    @unique
  name           String
  passwordHash   String
  active         Boolean   @default(true)
  userType       String    @default("EMPLOYEE") // EMPLOYEE | CLIENT | VENDOR | PARTNER | INVESTOR
  clientId       String?   // set for client portal users: the only client they can ever see
  branchId       String?
  departmentId   String?
  managerId      String?
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  manager      User?        @relation("Reports", fields: [managerId], references: [id])
  reports      User[]       @relation("Reports")
  roles        UserRole[]
  sessions     Session[]
  auditLogs    AuditLog[]

  @@index([organizationId])
}

model Role {
  id             String  @id @default(cuid())
  organizationId String
  key            String // e.g. SUPER_ADMIN
  name           String
  isSystem       Boolean @default(false)

  organization Organization    @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, key])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. bank.view_full
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId  String
  roleId  String
  expiresAt DateTime? // temporary access delegation

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Governance ----------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String // e.g. bank_account.update
  entity         String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

// Configuration change history (who changed which setting, when, old/new)
model SettingChange {
  id             String   @id @default(cuid())
  organizationId String
  section        String
  actorId        String?
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, section, createdAt])
}

// ---------- Company settings ----------

// One row per legal entity / document profile. Edits create a new version;
// issued documents later store a snapshot, so old rows are never overwritten.
model CompanyProfile {
  id             String   @id @default(cuid())
  organizationId String
  isDefault      Boolean  @default(false)
  version        Int      @default(1)
  legalName      String
  tradingName    String?
  website        String?
  email          String?
  description    String?
  globalUan      String?
  localUan       String?
  registeredOffice String?
  salesCentre    String?
  registrationNo String?
  taxId          String?
  legalNotice    String?
  invoiceFooter  String?
  defaultCurrency String  @default("USD")
  timezone       String   @default("UTC")
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String
  internalName   String
  bankName       String
  accountHolder  String
  country        String?
  branchName     String?
  accountNumber  String // shown masked unless bank.view_full
  iban           String?
  swift          String?
  routingCode    String?
  currency       String // PKR | USD | AED | GBP
  accountType    String   @default("CURRENT")
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  paymentInstructions String?
  verified       Boolean  @default(false) // manual entry never implies verified
  ledgerAccountId String?
  ledgerAccount  Account? @relation(fields: [ledgerAccountId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, currency])
}

// ---------- Phase 1: service catalog and CRM ----------

model ServiceCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)

  plans ServicePlan[]

  @@unique([organizationId, name])
}

model ServicePlan {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String
  name           String
  tagline        String?
  billingInterval String  @default("MONTHLY") // ONE_TIME | MONTHLY | QUARTERLY | ANNUAL | HOURLY | MILESTONE | CUSTOM
  isPopular      Boolean  @default(false)
  isPublic       Boolean  @default(true)
  active         Boolean  @default(true)
  version        Int      @default(1)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  prices   PlanPrice[]
  features PlanFeature[]
  leads    Lead[]

  @@index([organizationId, categoryId])
}

// Independent price per currency (never a converted copy of another currency)
model PlanPrice {
  id       String  @id @default(cuid())
  planId   String
  currency String
  amount   Decimal @db.Decimal(14, 2)
  setupFee Decimal? @db.Decimal(14, 2)

  plan ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currency])
}

model PlanFeature {
  id        String  @id @default(cuid())
  planId    String
  text      String
  included  Boolean @default(true)
  sortOrder Int     @default(0)

  plan ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model PipelineStage {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int
  probability    Int     @default(0)
  isWon          Boolean @default(false)
  isLost         Boolean @default(false)

  leads Lead[]

  @@unique([organizationId, name])
}

model Lead {
  id             String   @id @default(cuid())
  organizationId String
  number         Int      @default(autoincrement())
  name           String
  company        String?
  email          String?
  phone          String?
  country        String?
  source         String?
  serviceInterest String?
  planId         String?
  dealValue      Decimal? @db.Decimal(14, 2)
  currency       String   @default("USD")
  priority       String   @default("MEDIUM")
  stageId        String
  stageChangedAt DateTime @default(now())
  assignedToId   String?
  nextFollowUp   DateTime?
  notes          String?
  createdById    String?
  clientId       String?
  convertedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client     Client?       @relation(fields: [clientId], references: [id])
  stage      PipelineStage @relation(fields: [stageId], references: [id])
  plan       ServicePlan?  @relation(fields: [planId], references: [id])
  activities LeadActivity[]

  @@index([organizationId, stageId])
  @@index([organizationId, assignedToId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  actorId   String?
  kind      String // NOTE | CALL | EMAIL | STAGE_CHANGE | CREATED
  body      String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

// ---------- Phase 3: accounting core ----------

model NumberSequence {
  organizationId String
  key            String // INV, RCT, JE
  next           Int    @default(1)

  @@id([organizationId, key])
}

model Client {
  id             String   @id @default(cuid())
  organizationId String
  code           String? // assigned on creation, e.g. C-0001
  name           String
  email          String?
  phone          String?
  billingAddress String?
  country        String?
  taxId          String?
  currency       String   @default("USD")
  paymentTermsDays Int    @default(14)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  invoices Invoice[]
  payments Payment[]
  journalLines JournalLine[]
  leads    Lead[]
  invites  ClientInvite[]

  @@unique([organizationId, name])
}

model Account {
  id             String  @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String // ASSET | LIABILITY | EQUITY | REVENUE | DIRECT_COST | OPEX | OTHER_INCOME | OTHER_EXPENSE
  systemKey      String? // AR | TAX_PAYABLE | CUSTOMER_ADVANCES | REVENUE_SERVICE (used by automatic postings)
  active         Boolean @default(true)

  lines        JournalLine[]
  bankAccounts BankAccount[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
}

model JournalEntry {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  date           DateTime
  memo           String?
  currency       String
  status         String   @default("POSTED") // POSTED | REVERSED
  sourceType     String? // INVOICE | PAYMENT | MANUAL | REVERSAL
  sourceId       String?
  idempotencyKey String   @unique
  reversalOfId   String?  @unique
  postedById     String?
  createdAt      DateTime @default(now())

  lines JournalLine[]

  @@unique([organizationId, number])
  @@index([organizationId, date])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id        String  @id @default(cuid())
  entryId   String
  accountId String
  clientId  String?
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  memo      String?

  entry   JournalEntry @relation(fields: [entryId], references: [id])
  account Account      @relation(fields: [accountId], references: [id])
  client  Client?      @relation(fields: [clientId], references: [id])

  @@index([accountId])
  @@index([clientId])
  @@index([entryId])
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  number         String? // assigned when issued
  clientId       String
  status         String   @default("DRAFT") // DRAFT | ISSUED | PARTIALLY_PAID | PAID | CANCELLED
  currency       String
  issueDate      DateTime?
  dueDate        DateTime?
  subtotal       Decimal  @default(0) @db.Decimal(14, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2) // percent
  taxAmount      Decimal  @default(0) @db.Decimal(14, 2)
  total          Decimal  @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal  @default(0) @db.Decimal(14, 2)
  notes          String?
  // Frozen at issue time so later settings changes never alter issued documents
  companySnapshot Json?
  bankSnapshot    Json?
  journalEntryId String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client      Client       @relation(fields: [clientId], references: [id])
  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@unique([organizationId, number])
  @@index([organizationId, clientId, status])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  clientId       String
  bankAccountId  String
  currency       String
  amount         Decimal  @db.Decimal(14, 2)
  unallocated    Decimal  @default(0) @db.Decimal(14, 2)
  date           DateTime
  method         String   @default("BANK_TRANSFER")
  reference      String?
  idempotencyKey String   @unique
  journalEntryId String?
  receivedById   String?
  bankSnapshot   Json?
  createdAt      DateTime @default(now())

  client      Client      @relation(fields: [clientId], references: [id])
  allocations PaymentAllocation[]

  @@unique([organizationId, number])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(14, 2)

  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

// ---------- Phase 2: projects and tasks ----------

model Project {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  name           String
  clientId       String?
  managerId      String
  status         String   @default("ACTIVE") // ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  priority       String   @default("MEDIUM")
  startDate      DateTime?
  deadline       DateTime?
  budgetAmount   Decimal? @db.Decimal(14, 2)
  currency       String   @default("USD")
  scope          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members ProjectMember[]
  tasks   Task[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model ProjectMember {
  projectId String
  userId    String
  role      String? // e.g. Graphic Designer
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id             String   @id @default(cuid())
  projectId      String
  title          String
  description    String?
  status         String   @default("TODO") // TODO | IN_PROGRESS | REVIEW | DONE
  priority       String   @default("MEDIUM")
  assigneeId     String?
  dueDate        DateTime?
  estimatedHours Decimal? @db.Decimal(8, 2)
  clientVisible  Boolean  @default(false)
  blocked        Boolean  @default(false)
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments TaskComment[]

  @@index([projectId, status])
  @@index([assigneeId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  internal  Boolean  @default(true) // internal comments are never shown to clients
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ClientInvite {
  id        String    @id @default(cuid())
  clientId  String
  email     String
  tokenHash String    @unique // only the hash is stored; the link is shown once
  expiresAt DateTime
  usedAt    DateTime?
  createdById String?
  createdAt DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

// ---------- Phase 4: HR ----------

model EmployeeProfile {
  id             String   @id @default(cuid())
  organizationId String
  userId         String   @unique
  employeeNo     String
  designation    String?
  departmentId   String?
  employmentType String   @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | INTERN
  workLocation   String   @default("OFFICE") // OFFICE | REMOTE | HYBRID | FIELD
  joinDate       DateTime?
  probationEnd   DateTime?
  phone          String?
  personalEmail  String?
  address        String?
  emergencyContact String?
  // Sensitive: only users with hr.view_sensitive may read these
  identityNumber String?
  bankDetails    String?
  status         String   @default("ACTIVE") // ACTIVE | EXITED
  exitDate       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, employeeNo])
}

model AttendanceRecord {
  id        String    @id @default(cuid())
  userId    String
  workDate  String // YYYY-MM-DD in the company timezone
  clockIn   DateTime
  clockOut  DateTime?
  workMode  String    @default("OFFICE") // OFFICE | REMOTE
  note      String?
  correctedById String?

  breaks BreakRecord[]

  @@unique([userId, workDate])
  @@index([workDate])
}

model BreakRecord {
  id           String   @id @default(cuid())
  attendanceId String
  startAt      DateTime
  endAt        DateTime?

  attendance AttendanceRecord @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model LeaveType {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  daysPerYear    Decimal @db.Decimal(5, 1)
  paid           Boolean @default(true)
  active         Boolean @default(true)

  requests LeaveRequest[]

  @@unique([organizationId, name])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  userId      String
  leaveTypeId String
  startDate   String // YYYY-MM-DD
  endDate     String // YYYY-MM-DD
  days        Decimal   @db.Decimal(5, 1) // working days, weekends excluded
  reason      String?
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  approverId  String?
  decidedAt   DateTime?
  decisionNote String?
  createdAt   DateTime  @default(now())

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([userId, status])
}

// ---------- Phase 4: payroll ----------

model SalaryStructure {
  id            String   @id @default(cuid())
  userId        String
  effectiveFrom String // YYYY-MM-DD
  currency      String
  basic         Decimal  @db.Decimal(14, 2)
  allowance     Decimal  @default(0) @db.Decimal(14, 2)
  taxPercent    Decimal  @default(0) @db.Decimal(5, 2) // flat withholding; replace with jurisdiction rules later
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([userId, effectiveFrom])
  @@index([userId])
}

model PayrollRun {
  id             String   @id @default(cuid())
  organizationId String
  period         String // YYYY-MM
  currency       String
  status         String   @default("DRAFT") // DRAFT | APPROVED | POSTED | PAID
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  postedAt       DateTime?
  paidAt         DateTime?
  journalEntryId String?
  paymentEntryId String?
  createdAt      DateTime @default(now())

  items PayrollItem[]

  @@unique([organizationId, period, currency])
}

model PayrollItem {
  id              String  @id @default(cuid())
  runId           String
  userId          String
  workingDays     Int
  unpaidDays      Decimal @db.Decimal(5, 1)
  basic           Decimal @db.Decimal(14, 2)
  allowance       Decimal @db.Decimal(14, 2)
  bonus           Decimal @default(0) @db.Decimal(14, 2)
  unpaidDeduction Decimal @db.Decimal(14, 2)
  gross           Decimal @db.Decimal(14, 2)
  taxPercent      Decimal @db.Decimal(5, 2)
  tax             Decimal @db.Decimal(14, 2)
  net             Decimal @db.Decimal(14, 2)

  run PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
}

// ---------- Phase 3: expenses and budgets ----------

model Budget {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  scope          String   @default("COMPANY") // COMPANY | DEPARTMENT | PROJECT
  projectId      String?
  departmentId   String?
  periodStart    String // YYYY-MM-DD
  periodEnd      String
  currency       String
  originalAmount Decimal  @db.Decimal(14, 2) // never overwritten; transfers are tracked separately
  createdById    String?
  createdAt      DateTime @default(now())

  vouchers     ExpenseVoucher[]
  transfersOut BudgetTransfer[] @relation("from")
  transfersIn  BudgetTransfer[] @relation("to")

  @@index([organizationId])
}

model BudgetTransfer {
  id           String    @id @default(cuid())
  fromBudgetId String
  toBudgetId   String
  amount       Decimal   @db.Decimal(14, 2)
  reason       String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedById String
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  from Budget @relation("from", fields: [fromBudgetId], references: [id])
  to   Budget @relation("to", fields: [toBudgetId], references: [id])
}

model ExpenseVoucher {
  id               String   @id @default(cuid())
  organizationId   String
  number           String
  date             String // YYYY-MM-DD
  payee            String
  description      String
  justification    String?
  expenseAccountId String
  projectId        String?
  budgetId         String?
  currency         String
  amount           Decimal  @db.Decimal(14, 2)
  status           String   @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | POSTED | PAID | REJECTED | CANCELLED
  submittedById    String
  reviewedById     String?
  approvedById     String?
  decisionNote     String?
  overBudgetReason String?
  journalEntryId   String?
  paymentEntryId   String?
  paidById         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  budget Budget? @relation(fields: [budgetId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([submittedById])
}
