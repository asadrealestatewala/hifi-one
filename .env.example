# Copy to .env for local development. Placeholder values only.
DATABASE_URL="postgresql://hifi:hifi_local_dev@localhost:54329/hifi_one"
# Generate a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# Optional, production only: if set, the first-run setup page checks it when someone enters it. Setup works without it while the database has no users.
# SETUP_TOKEN="change-me-to-a-long-random-string"
# Where uploaded files are kept (receipts, bills, employee documents). Use a folder outside the code and back it up with the database.
# STORAGE_DIR="D:/hifi-files"
# Outgoing email (any SMTP account). Leave empty to keep email switched off: documents are then logged as not sent.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="Hifi Marketing and Technologies <billing@example.com>"
# Resend API (preferred over SMTP when set; also needed to receive mail). Full-access key.
# RESEND_API_KEY=""
# Signing secret of the Resend webhook for the email.received event (whsec_...). Receiving stays off without it.
# RESEND_WEBHOOK_SECRET=""
# Domain that new mailbox addresses are created on (Settings > Mailboxes)
# MAIL_DOMAIN="hifimarketing.co"
# Business assistant (optional). Leave empty to keep it switched off; no question is sent anywhere without a key.
# ANTHROPIC_API_KEY=""
# ASSISTANT_MODEL="claude-sonnet-5-5"
# Video meetings: your own STUN/TURN servers (JSON). Without this, public Google STUN is used, which is enough on open networks only.
# ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
SESSION_SECRET="change-me-to-a-long-random-string"
