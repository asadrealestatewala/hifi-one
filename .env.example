# Copy to .env for local development. Placeholder values only.
DATABASE_URL="postgresql://hifi:hifi_local_dev@localhost:54329/hifi_one"
# Generate a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# Production only: a random value of 16+ characters that must be entered on the first-run setup page, so only you can create the first administrator.
# SETUP_TOKEN="change-me-to-a-long-random-string"
# Where uploaded files are kept (receipts, bills, employee documents). Use a folder outside the code and back it up with the database.
# STORAGE_DIR="D:/hifi-files"
# Outgoing email (any SMTP account). Leave empty to keep email switched off: documents are then logged as not sent.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM="Hifi Marketing and Technologies <billing@example.com>"
# Business assistant (optional). Leave empty to keep it switched off; no question is sent anywhere without a key.
# ANTHROPIC_API_KEY=""
# ASSISTANT_MODEL="claude-sonnet-5-5"
SESSION_SECRET="change-me-to-a-long-random-string"
